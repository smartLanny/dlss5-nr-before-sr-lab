+// Control-only state provenance. Never seeds the production observer table.
+struct ControlSlotStates {
+ NrContext* context=nullptr;NrSlot* slot=nullptr;bool fresh_factory=false,observed=false,retired=false;
+ std::array<ID3D12Resource*,2> resources{};
+ std::array<nr_source_runtime::Resource,2> identities{};
+ std::array<D3D12_RESOURCE_STATES,2> proven{};
+ unsigned long long prior_token=0,prior_native=0,prior_reset=0;
+ void BeforeFactory(NrContext& ctx){
+  if(slot){Check(context==&ctx&&retired,"control reuse only after its real exact retirement");return;}
+  Check(!fresh_factory&&ctx.frames_seen==1&&ctx.slot_serial==0,"control first factory in actual fresh context");
+  for(const auto& entry:ctx.slots)Check(!entry.key&&!entry.proxy&&!entry.neural,"actual entire slot pool empty before fresh allocation");
+  context=&ctx;fresh_factory=true;
+ }
+ void Bind(NrContext& ctx,NrSlot& value){
+  Check(context==&ctx,"control actual context identity unchanged");
+  if(slot){Check(slot==&value&&resources[0]==value.proxy&&resources[1]==value.neural,"control exact same live slot and resource owners");return;}
+  Check(fresh_factory&&ctx.slot_serial==1&&value.last_used_serial==1&&value.proxy&&value.neural&&value.proxy!=value.neural,
+   "successful fresh CreateSlot path allocates these exact two resources");
+  // The immutable actual Core path CreateSlot:9498 -> CreateTexture:9122-9124
+  // creates both textures with InitialResourceState COMMON. Empty pool above,
+  // successful factory return and this immediate binding exclude prior use.
+  Check(value.proxy_state==D3D12_RESOURCE_STATE_COMMON&&value.neural_state==D3D12_RESOURCE_STATE_COMMON,
+   "fresh actual factory COMMON contract matches slot scalars before first use");
+  slot=&value;resources={value.proxy,value.neural};
+  nr_source_runtime::Lock lock;
+  for(unsigned i=0;i<2;++i){identities[i]=nr_source_runtime::ResourceOf(resources[i]);Check(bool(identities[i]),"fresh owned resource actual lifetime and device identity");proven[i]=D3D12_RESOURCE_STATE_COMMON;}
+  std::printf("CONTROL_SLOT_FACTORY context=%p slot=%p proxy=%p neural=%p emptyPoolBefore=1 slotSerial=1 successfulActualCreateSlot=1 initialState=0 initialStateSource=actual-CreateTexture-COMMON neverPreviouslyUsed=1\n",(void*)context,(void*)slot,(void*)resources[0],(void*)resources[1]);
+ }
+ void Prepare(ID3D12GraphicsCommandList* list,NrFlight& flight,unsigned iteration){
+  Check(slot&&flight.slot==slot&&flight.owner==context&&iteration<2,"control state owner matches actual pinned flight");
+  if(iteration==0)Check(fresh_factory&&!observed&&!retired&&!prior_token,"first use requires actual fresh factory provenance");
+  else Check(observed&&retired&&flight.token!=prior_token&&flight.native_token==prior_native&&flight.reset==prior_reset+1,
+   "same resources carry actual prior observation only through exact fence and successful Reset");
+  const char* roles[]={"proxy","neural"};D3D12_RESOURCE_STATES* scalars[]={&slot->proxy_state,&slot->neural_state};
+  for(unsigned i=0;i<2;++i){
+   unsigned current=0;bool known=false;
+   {nr_source_runtime::Lock lock;Check(nr_source_runtime::ResourceOf(resources[i])==identities[i],"control resource lifetime/device unchanged");
+    known=nr_source_runtime::StateOf(nr_source_runtime::RecordingOf(list),identities[i],current);}
+   Check(*scalars[i]==proven[i]&&(!known||current==unsigned(proven[i])),"control before state equals fresh factory or prior actual observed state");
+   const auto wanted=D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+   const auto middle=proven[i]==wanted?D3D12_RESOURCE_STATE_COPY_SOURCE:wanted;
+   Transition(list,resources[i],*scalars[i],middle);if(middle!=wanted)Transition(list,resources[i],*scalars[i],wanted);
+   unsigned actual=0;bool actual_known=false;
+   {nr_source_runtime::Lock lock;actual_known=nr_source_runtime::StateOf(nr_source_runtime::RecordingOf(list),identities[i],actual);}
+   std::printf("CONTROL_SLOT_PREPARE iteration=%u role=%s resource=%p token=%llu before=%u origin=%s middle=%u target=8 known=%u observed=%u priorToken=%llu priorReset=%llu\n",
+    iteration,roles[i],(void*)resources[i],flight.token,unsigned(proven[i]),iteration?"prior-actual-observer-after-exact-retirement":"actual-fresh-factory-COMMON",unsigned(middle),actual_known,actual,prior_token,prior_reset);
+   Check(actual_known&&actual==unsigned(wanted),"control real transition must establish current-recording state for each resource");
+  }
+  retired=false;
+ }
+ void ObserveForRetire(ID3D12GraphicsCommandList* list,NrFlight& flight){
+  Check(slot==flight.slot&&context==flight.owner&&!retired,"control state observation precedes its own retirement");
+  const char* roles[]={"proxy","neural"};const D3D12_RESOURCE_STATES scalars[]={slot->proxy_state,slot->neural_state};
+  nr_source_runtime::Lock lock;
+  for(unsigned i=0;i<2;++i){unsigned actual=0;
+   Check(nr_source_runtime::ResourceOf(resources[i])==identities[i]&&nr_source_runtime::StateOf(nr_source_runtime::RecordingOf(list),identities[i],actual)&&actual==unsigned(scalars[i]),
+    "control saved state comes from actual observer after readback return transitions");
+   proven[i]=static_cast<D3D12_RESOURCE_STATES>(actual);
+   std::printf("CONTROL_SLOT_OBSERVED role=%s resource=%p token=%llu state=%u afterReadbackReturnTransitions=1\n",roles[i],(void*)resources[i],flight.token,actual);
+  }
+  prior_token=flight.token;prior_native=flight.native_token;prior_reset=flight.reset;observed=true;
+ }
+ void AfterExactRetire(ID3D12GraphicsCommandList* list,NrFlight& flight){
+  const auto native=SnapshotPostBoundaryList(list);
+  Check(observed&&!retired&&prior_token==flight.token&&native.known&&native.token==prior_native&&native.reset==prior_reset+1&&
+   !active_flight&&!flight.clear.pending&&!context->lifecycle_dependencies_quarantined&&!g_lifecycle_tracking_uncertain.load(),
+   "control state carry follows completed NrFlight Finish exact fence Reset and clear-owner retirement");
+  Check(slot->recording_command_lists==0&&CanMutateSlotLocked(*slot),"same slot genuinely mutable after real exact retirement");
+  retired=true;
+  std::printf("CONTROL_SLOT_STATE_RETIRED token=%llu nativeToken=%llu observedReset=%llu completedReset=%llu sameResources=1 source=actual-StateOf-then-NrFlightFinish\n",prior_token,prior_native,prior_reset,native.reset);
+ }
+};
