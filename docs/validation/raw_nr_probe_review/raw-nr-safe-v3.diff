+// Included inside raw_nr_probe. This is a host owner, not a Core modification.
+struct ClearCpuOwner {
+ ID3D12DescriptorHeap* heap=nullptr;ID3D12Resource* retained=nullptr;
+ unsigned long long recording_token=0;bool pending=false;
+ void Prepare(queue_test::Fixture& f,NrSlot& slot,NrBindingPacket& packet){
+  Check(!pending&&!retained&&!recording_token,"CPU clear descriptor reused only after exact retirement");
+  const auto& view=packet.plan.heaps[nr_binding::Codec].views[kCodecMotionUavIndex];
+  Check(packet.valid&&view.kind==nr_binding::ViewKind::Uav2D&&view.resource==slot.neural&&view.format==DXGI_FORMAT_R16G16B16A16_FLOAT,"CPU clear view matches immutable actual GPU u2 resource/format");
+  const auto resource=ID3D12Resource_GetDesc(slot.neural);
+  Check(resource.Dimension==D3D12_RESOURCE_DIMENSION_TEXTURE2D&&resource.Format==view.format&&resource.Width==rw&&resource.Height==rh&&resource.DepthOrArraySize==1&&resource.MipLevels==1&&resource.SampleDesc.Count==1,"actual clear resource GetDesc typed plane");
+  if(!heap)heap=descriptor_warp_test::Heap(f,D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV,false,1);
+  const auto cpu=ID3D12DescriptorHeap_GetDesc(heap),gpu=ID3D12DescriptorHeap_GetDesc(packet.heaps[nr_binding::Codec]);
+  Check(cpu.Type==D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV&&cpu.Flags==D3D12_DESCRIPTOR_HEAP_FLAG_NONE&&cpu.NumDescriptors==1&&gpu.Type==cpu.Type&&gpu.Flags==D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE,"clear CPU heap nonvisible and actual bound GPU heap visible");
+  retained=slot.neural;ID3D12Resource_AddRef(retained);pending=true;
+  // Write the same one-mip Texture2D typed view directly from the immutable
+  // value recipe. Never copy a descriptor from a shader-visible CPU address.
+  descriptor_warp_test::Uav(f,retained,descriptor_warp_test::Cpu(f,heap),view.format);
+  std::printf("CLEAR_CPU_OWNER heap=%p flags=%u gpuHeap=%p gpuFlags=%u resource=%p format=%u extent=%llux%u sample=%u mip=0 plane=0 sameImmutableView=1 resourceRetained=1\n",(void*)heap,unsigned(cpu.Flags),(void*)packet.heaps[nr_binding::Codec],unsigned(gpu.Flags),(void*)retained,unsigned(resource.Format),resource.Width,resource.Height,resource.SampleDesc.Count);
+ }
+ void Pin(unsigned long long token){Check(pending&&retained&&heap&&token&&!recording_token,"clear CPU owner pins exact real recording");recording_token=token;}
+ void Record(queue_test::Fixture& f,ID3D12GraphicsCommandList* list,NrBindingPacket& packet,NrSlot& slot){
+  Check(pending&&retained==slot.neural&&recording_token,"actual typed clear owner live through recording");
+  {nr_source_runtime::Lock lock;unsigned state=0;
+   Check(nr_source_runtime::StateOf(nr_source_runtime::RecordingOf(list),nr_source_runtime::ResourceOf(slot.neural),state)&&state==unsigned(slot.neural_state),"clear before-state matches actual native resource observation");}
+  Transition(list,slot.neural,slot.neural_state,D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  auto* gpu=packet.heaps[nr_binding::Codec];ID3D12GraphicsCommandList_SetDescriptorHeaps(list,1,&gpu);
+  const float sentinel[4]={-1234,-1234,-1234,-1234};UavBarrier(list,slot.neural);
+  ID3D12GraphicsCommandList_ClearUnorderedAccessViewFloat(list,descriptor_warp_test::Gpu(f,gpu,kCodecMotionUavIndex),descriptor_warp_test::Cpu(f,heap),slot.neural,sentinel,0,nullptr);
+  UavBarrier(list,slot.neural);
+  std::printf("CLEAR_RECORDED token=%llu cpuHeap=%p gpuHeap=%p resource=%p sentinel=-1234 prePostUAVBarrier=1\n",recording_token,(void*)heap,(void*)gpu,(void*)retained);
+ }
+ void Retire(unsigned long long token){if(!pending)return;
+  Check(recording_token==token&&retained&&heap,"clear owner exact retired recording matches");
+  std::printf("CLEAR_CPU_RETIRED token=%llu heap=%p resource=%p afterExactFenceAndReset=1\n",token,(void*)heap,(void*)retained);
