{
  "name": "xiaofeng-dlss5-manager",
  "version": "0.4.6-hotfix.7-dev.7",
  "private": true,
  "description": "A beginner-friendly desktop manager for the DLSS 5 NR-before-SR add-on.",
  "main": "main.js",
  "author": "野生的装机宅 / 装机宅版 contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:unit && npm run test:ui-contract",
    "test:unit": "node --test --test-concurrency=1 test/*.test.js",
    "test:ui-contract": "node scripts/check-ui.js",
    "verify:vendor": "node scripts/verify-vendor.js",
    "verify:payload": "node scripts/verify-payload.js",
    "icon": "electron scripts/build-icon.js",
    "build": "node scripts/prepare-core-catalog.js && npm run icon && npm run verify:vendor && npm run verify:payload && npm run verify:fg-components && electron-builder --win",
    "build:portable": "node scripts/prepare-core-catalog.js && npm run icon && npm run verify:vendor && npm run verify:payload && npm run verify:fg-components && electron-builder --win portable",
    "verify:fg-components": "node scripts/verify-fg-components.js",
    "verify:execution-level": "node scripts/verify-execution-level.js",
    "build:external": "npm run icon && npm run verify:vendor && npm run verify:fg-components && electron-builder --win --config scripts/external-build-config.cjs && npm run verify:external",
    "verify:external": "node scripts/verify-external-package.cjs dist-external/win-unpacked"
  },
  "dependencies": {
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "buildVersion": "0.4.6.7",
    "appId": "com.xiaofeng.dlss5.manager",
    "productName": "DLSS 5 AI 超分管理器",
    "files": [
      "main.js",
      "preload.js",
      "build/icon.png",
      "src/**/*",
      "vendor/DLSS5-Swapper/LICENSE",
      "vendor/DLSS5-Swapper/src/library.js",
      "vendor/DLSS5-Swapper/src/core/pe.js",
      "vendor/DLSS5-Swapper/src/core/emulators.js",
      "vendor/DLSS5-Swapper/src/core/feeder-release.js",
      "vendor/DLSS5-Swapper/src/core/file-journal.js",
      "vendor/DLSS5-Swapper/src/core/scan.js",
      "vendor/DLSS5-Swapper/src/core/install-guards.js",
      "vendor/DLSS5-Swapper/src/steamart.js",
      "package.json",
      "product.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "UPSTREAM.md"
    ],
    "extraResources": [
      {
        "from": "payload",
        "to": "payload",
        "filter": [
          "nr-before-sr/bundle.json",
          "nr-before-sr/fixed/**/*",
          "nr-before-sr/versions/*/*",
          "nr-before-sr/README.md",
          "!nr-before-sr/versions/0.4.5*/**/*",
          "!nr-before-sr/versions/0.4.6/**/*",
          "!nr-before-sr/versions/0.4.6-ota/**/*"
        ]
      },
      {
        "from": "src/product/nvapi-drs.ps1",
        "to": "nvapi-drs.ps1"
      },
      {
        "from": "src/product/nvapi-profile.ps1",
        "to": "nvapi-profile.ps1"
      },
      {
        "from": "resources/fg-components",
        "to": "fg-components",
        "filter": [
          "manifest.json",
          "*.dll",
          "*.asi",
          "*.addon64",
          "global.ini",
          "LICENSE",
          "MINHOOK-LICENSE.txt",
          "UAL-LICENSE"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "fileAssociations": [
      {
        "ext": "addon64",
        "name": "DLSS 5 Addon",
        "description": "DLSS 5 AI 超分 Addon 文件",
        "role": "Editor"
      }
    ],
    "portable": {
      "requestExecutionLevel": "admin",
      "artifactName": "DLSS5-Manager-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DLSS 5 AI 超分管理器",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "DLSS5-Manager-Setup-${version}.exe"
    }
  }
}
