<Window x:Class="Dlss5InstallAssistant.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DLSS5 安装助手" Width="1100" Height="820" MinWidth="860" MinHeight="650" Background="#F5F6F8">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock FontSize="25" FontWeight="SemiBold">DLSS5 安装助手</TextBlock><TextBlock Margin="0,6,0,12" Foreground="#505866" TextWrapping="Wrap">首版支持赛博朋克2077、巫师3的 D3D12 版本。建议先选 0.4.1-r3 增强主测版；遇到兼容问题再选 0.3.7-r3 稳妥兼容版。请先完全退出游戏；其他游戏可查看，暂不自动安装，HD2 实验版也不会自动部署。</TextBlock>
   <StackPanel x:Name="ControlsPanel"><WrapPanel><Button Padding="12,7" Margin="0,0,7,7" Click="ScanSteam">扫描 Steam</Button><Button Padding="12,7" Margin="0,0,7,7" Click="ChooseExe">选择游戏程序</Button><Button Padding="12,7" Margin="0,0,7,7" Click="ImportPackage">导入完整组件包</Button><Button Padding="12,7" Margin="0,0,7,7" Click="RefreshStatus">刷新运行状态</Button></WrapPanel><Expander Header="高级选项" Margin="0,0,0,8"><WrapPanel Margin="0,8,0,0"><Button Padding="12,7" Margin="0,0,7,5" Click="ImportReShade">导入官方 ReShade 安装程序</Button><Button Padding="12,7" Margin="0,0,7,5" Click="Recover">恢复中断事务</Button></WrapPanel></Expander></StackPanel>
   <TextBlock x:Name="PackageLabel" Margin="0,0,0,12" TextWrapping="Wrap" Text="尚未导入安装包；首次安装会准备官方 ReShade 6.8 FullAddon。"/>
  </StackPanel>
  <DataGrid x:Name="Games" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" Background="White"><DataGrid.Columns><DataGridTextColumn Header="游戏" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="API" Binding="{Binding Api}" Width="70"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="3*"/><DataGridTextColumn Header="路径" Binding="{Binding Directory}" Width="3*"/></DataGrid.Columns></DataGrid>
  <Grid Grid.Row="2" Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><WrapPanel x:Name="ActionPanel"><Button Padding="18,7" Margin="0,0,7,5" Click="Install">安装 / 更新</Button><Button Padding="12,7" Margin="0,0,7,5" Click="Launch">启动游戏</Button><Button Padding="12,7" Margin="0,0,7,5" Click="Inspect">查看安装计划</Button><Button Padding="12,7" Margin="0,0,7,5" Click="Uninstall">卸载并还原</Button></WrapPanel><Button Grid.Column="1" x:Name="CancelInstallButton" Padding="12,7" Click="CancelInstall" IsEnabled="False">取消操作</Button></Grid>
  <TextBox x:Name="PlanBox" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="White" Padding="10" Margin="0,0,0,10" Text="检查后在这里显示本次将写入、复用或移除的文件。"/>
  <TextBox x:Name="LogBox" Grid.Row="4" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" Background="White"/>
 </Grid>
</Window>
