<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <AssemblyName>DLSS5InstallAssistant.Helper</AssemblyName>
    <RootNamespace>Dlss5InstallAssistant.Helper</RootNamespace>
  </PropertyGroup>
  <ItemGroup><Compile Include="../install-assistant/*.cs" Exclude="../install-assistant/App.xaml.cs" Link="%(Filename)%(Extension)" /></ItemGroup>
</Project>
