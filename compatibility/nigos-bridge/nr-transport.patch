new file mode 100644
index 0000000..f820c75
--- /dev/null
+++ b/src/bridge-contract.hpp
@@ -0,0 +1,18 @@
+#pragma once
+
+#include <cstdint>
+
+namespace bridge_contract
+{
+inline bool RealFenceReached(std::uint64_t completed, std::uint64_t wanted)
+{
+    // D3D12 reports device removal as UINT64_MAX. It is numerically beyond every
+    // submitted value, but it is not evidence that any GPU work retired.
+    return completed != UINT64_MAX && completed >= wanted;
+}
+
+inline bool NeedsNativeFallback(bool native_was_suppressed, bool bridge_delivered)
+{
+    return native_was_suppressed && !bridge_delivered;
+}
+}
