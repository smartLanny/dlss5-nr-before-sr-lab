+// completion=sync (and auto after it latches) uses the progress fence that only
+// the D3D12 queue can signal. The shared session fence is deliberately excluded:
+// asynchronous rescue may have advanced it from the CPU, which is enough to
+// unblock D3D11 but is not proof that the producer finished. Only after this
+// function succeeds may the frame enqueue its D3D11 output copy.
+static bool BridgeWaitForRealOutput(UINT64 wanted)
+{
+    ID3D12Fence *truth = g_bridge.fence_progress;
+    if (truth == nullptr || g_bridge.fence_event == nullptr)
+    {
+        BridgeLatchSynchronousCompletion("a missing real-progress fence");
+        Log("[bridge] synchronous output cannot verify fence %llu; this frame stays native.",
+            wanted);
+        BridgeFail("real GPU completion is unavailable");
+        return false;
+    }
+
+    const ULONGLONG deadline = GetTickCount64() + 500;
+    for (;;)
+    {
+        const UINT64 done = truth->GetCompletedValue();
+        if (bridge_contract::RealFenceReached(done, wanted)) return true;
+        if (done == UINT64_MAX)
+        {
+            BridgeDeviceLost();
+            return false;
+        }
+        const ULONGLONG now = GetTickCount64();
+        if (now >= deadline)
+        {
+            BridgeEnterStall(done, wanted, "synchronous output");
+            return false;
+        }
+        if (FAILED(truth->SetEventOnCompletion(wanted, g_bridge.fence_event)))
+        {
+            BridgeLatchSynchronousCompletion("a failed real-progress wait");
+            Log("[bridge] the real-progress fence refused a synchronous wait; this frame stays native.");
+            BridgeFail("real GPU completion wait");
+            return false;
+        }
+        WaitForSingleObject(g_bridge.fence_event, static_cast<DWORD>(deadline - now));
+    }
+}
