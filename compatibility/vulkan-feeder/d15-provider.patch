+#pragma once
+#include <windows.h>
+#include <d3d12.h>
+#include <dxgi1_4.h>
+#include <cstdint>
+#include <cstring>
+
+// Included after feed_vk.h. Bind physical devices and queue families to the
+// actual VkDevice/VkQueue; upstream's last-created-device globals are insufficient
+// in processes with multiple Vulkan devices. No fallback to queue family zero.
+namespace nr_external_provider_vk {
+inline bool quarantined = false;
+struct Binding {
+    VkDevice device = VK_NULL_HANDLE;
+    VkPhysicalDevice physical = VK_NULL_HANDLE;
+    VkQueue queue = VK_NULL_HANDLE;
+    std::uint32_t family = VK_QUEUE_FAMILY_IGNORED;
+    LUID luid{};
+};
+inline SRWLOCK bindings_lock = SRWLOCK_INIT;
+inline Binding bindings[128]{};
+inline bool SameLuid(const LUID &a, const LUID &b) noexcept {
+    return a.LowPart == b.LowPart && a.HighPart == b.HighPart;
+}
+
+// ReShade 6.8's fixed escape hatch. The Vulkan transport owns a private D3D12
+// device, so normalize it before creating any queue/list/resource wrappers.
+constexpr GUID kUnwrappedObject = {
+    0x7f2c9a11, 0x3b4e, 0x4d6a,
+    {0x81, 0x2f, 0x5e, 0x9c, 0xd3, 0x7a, 0x1b, 0x42}};
+
+inline bool ResolvePrivateDeviceIdentity(IUnknown *object,
+                                         IUnknown **identity) {
+    if (!identity) return false;
+    *identity = nullptr;
+    if (!object) return false;
+    IUnknown *unwrapped = nullptr;
+    const HRESULT unwrap_hr = object->QueryInterface(
+        kUnwrappedObject, reinterpret_cast<void **>(&unwrapped));
+    if (FAILED(unwrap_hr) && unwrap_hr != E_NOINTERFACE) return false;
+    if (SUCCEEDED(unwrap_hr) && !unwrapped) return false;
+    const HRESULT identity_hr = (unwrapped ? unwrapped : object)->QueryInterface(
+        IID_IUnknown, reinterpret_cast<void **>(identity));
+    if (unwrapped) unwrapped->Release();
+    return SUCCEEDED(identity_hr) && *identity;
+}
+
+// On success, 'device' keeps exactly one caller-owned reference. A ReShade
+// proxy is released only after the returned native reference and both canonical
+// identities are live. E_NOINTERFACE means the original was already native.
+inline bool NormalizePrivateDevice(ID3D12Device *&device,
+                                   const LUID &expected_luid,
+                                   bool &unwrapped_proxy,
+                                   HRESULT &failure) {
+    unwrapped_proxy = false;
+    failure = E_FAIL;
+    if (!device) { failure = E_POINTER; return false; }
+
+    ID3D12Device *native = nullptr;
+    const HRESULT unwrap_hr = device->QueryInterface(
+        kUnwrappedObject, reinterpret_cast<void **>(&native));
+    if (unwrap_hr == E_NOINTERFACE) {
+        IUnknown *identity = nullptr;
+        const HRESULT identity_hr = device->QueryInterface(
+            IID_IUnknown, reinterpret_cast<void **>(&identity));
+        if (identity) identity->Release();
+        if (FAILED(identity_hr) || !identity) {
+            failure = FAILED(identity_hr) ? identity_hr : E_POINTER;
+            return false;
+        }
+        if (!SameLuid(device->GetAdapterLuid(), expected_luid)) {
+            failure = DXGI_ERROR_INVALID_CALL;
+            return false;
+        }
+        failure = S_OK;
+        return true;
+    }
+    if (FAILED(unwrap_hr) || !native) {
+        if (native) native->Release();
+        failure = FAILED(unwrap_hr) ? unwrap_hr : E_POINTER;
+        return false;
+    }
+
+    IUnknown *proxy_identity = nullptr;
+    IUnknown *native_identity = nullptr;
+    const bool proxy_proven = ResolvePrivateDeviceIdentity(device, &proxy_identity);
+    const bool native_proven = ResolvePrivateDeviceIdentity(native, &native_identity);
+    const bool same = proxy_proven && native_proven &&
+                      proxy_identity == native_identity;
+    if (proxy_identity) proxy_identity->Release();
+    if (native_identity) native_identity->Release();
+    if (!same || !SameLuid(native->GetAdapterLuid(), expected_luid)) {
+        native->Release();
+        failure = same ? DXGI_ERROR_INVALID_CALL : E_NOINTERFACE;
+        return false;
+    }
+
+    ID3D12Device *proxy = device;
+    device = native; // owns the reference returned by IID_UnwrappedObject
+    unwrapped_proxy = true;
+    failure = S_OK;
+    proxy->Release();
+    return true;
+}
+inline void Forget(VkDevice device) {
+    AcquireSRWLockExclusive(&bindings_lock);
+    for (auto &row : bindings) if (row.device == device) row = {};
+    ReleaseSRWLockExclusive(&bindings_lock);
+}
+inline bool Find(VkDevice device, VkQueue queue, Binding &out) {
+    bool found = false;
+    AcquireSRWLockShared(&bindings_lock);
+    for (const auto &row : bindings) if (row.device == device && row.queue == queue && row.physical) {
+        out = row; found = true; break;
+    }
+    ReleaseSRWLockShared(&bindings_lock);
+    return found;
+}
+inline void Remember(VkPhysicalDevice physical, VkDevice device, const VkDeviceCreateInfo *info) {
+    Forget(device);
+    if (!physical || !device || !info || !info->pQueueCreateInfos || info->queueCreateInfoCount > 32) return;
+    HMODULE loader = GetModuleHandleW(L"vulkan-1.dll");
+    if (!loader) return;
+    auto properties = reinterpret_cast<PFN_vkGetPhysicalDeviceProperties2>(GetProcAddress(loader, "vkGetPhysicalDeviceProperties2"));
+    auto families = reinterpret_cast<PFN_vkGetPhysicalDeviceQueueFamilyProperties>(GetProcAddress(loader, "vkGetPhysicalDeviceQueueFamilyProperties"));
+    auto gdpa = reinterpret_cast<PFN_vkGetDeviceProcAddr>(GetProcAddress(loader, "vkGetDeviceProcAddr"));
+    if (!properties || !families || !gdpa) return;
+    auto get_queue = reinterpret_cast<PFN_vkGetDeviceQueue>(gdpa(device, "vkGetDeviceQueue"));
+    if (!get_queue) return;
+    VkPhysicalDeviceIDProperties ids{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES};
+    VkPhysicalDeviceProperties2 props{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2};
+    props.pNext = &ids; properties(physical, &props);
+    if (!ids.deviceLUIDValid || props.properties.vendorID != 0x10de) return;
+    std::uint32_t count = 0;
+    families(physical, &count, nullptr);
+    if (!count || count > 64) return;
+    VkQueueFamilyProperties family_properties[64]{};
+    families(physical, &count, family_properties);
+    Binding pending[128]{}; std::uint32_t used = 0;
+    LUID luid{}; static_assert(sizeof(luid) == VK_LUID_SIZE);
+    std::memcpy(&luid, ids.deviceLUID, sizeof(luid));
+    for (std::uint32_t i = 0; i < info->queueCreateInfoCount; ++i) {
+        const auto &q = info->pQueueCreateInfos[i];
+        if (q.flags || q.queueFamilyIndex >= count ||
+            !(family_properties[q.queueFamilyIndex].queueFlags & VK_QUEUE_GRAPHICS_BIT)) continue;
+        if (q.queueCount > 128 - used) return;
+        for (std::uint32_t j = 0; j < q.queueCount; ++j) {
+            VkQueue queue = VK_NULL_HANDLE;
+            get_queue(device, q.queueFamilyIndex, j, &queue);
+            if (!queue) return;
+            pending[used++] = {device, physical, queue, q.queueFamilyIndex, luid};
+        }
+    }
+    AcquireSRWLockExclusive(&bindings_lock);
+    std::uint32_t free = 0;
+    for (const auto &row : bindings) if (!row.device) ++free;
+    if (free >= used) {
+        std::uint32_t next = 0;
+        for (auto &row : bindings) if (!row.device && next < used) row = pending[next++];
+    }
+    ReleaseSRWLockExclusive(&bindings_lock);
+}
+
+// Dynamic DXGI resolution matches the pinned Feeder build, which does not link
+// dxgi.lib. The selected adapter is retained for the caller, never the default.
+inline IDXGIAdapter1 *OpenAdapter(const LUID &luid) {
+    // Keep one System32 module reference for every COM object returned through
+    // this dynamically resolved factory. It is released by the loader at exit.
+    static HMODULE dxgi = LoadLibraryExW(
+        L"dxgi.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+    if (!dxgi) return nullptr;
+    using FactoryFn = HRESULT (WINAPI *)(REFIID, void **);
+    auto create = reinterpret_cast<FactoryFn>(GetProcAddress(dxgi, "CreateDXGIFactory1"));
+    IDXGIFactory1 *factory = nullptr; IDXGIAdapter1 *selected = nullptr;
+    if (create && SUCCEEDED(create(__uuidof(IDXGIFactory1), reinterpret_cast<void **>(&factory)))) {
+        for (UINT i = 0; ; ++i) {
+            IDXGIAdapter1 *adapter = nullptr;
+            if (factory->EnumAdapters1(i, &adapter) != S_OK) break;
+            DXGI_ADAPTER_DESC1 desc{};
+            if (SUCCEEDED(adapter->GetDesc1(&desc)) && desc.VendorId == 0x10de &&
+                !(desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE) && SameLuid(desc.AdapterLuid, luid)) {
+                selected = adapter; break;
+            }
+            adapter->Release();
+        }
+        factory->Release();
+    }
+    return selected;
+}
+}
