+// Included immediately before the production FeedFrameVk callback. The Vulkan
+// copies, layouts and ownership transfers remain in that callback; this is its
+// D3D12 middle, using the existing project Core ABI and completion helpers.
+struct NrFeedVkSyncOps {
+    DWORD timeout() const { return static_cast<DWORD>(g_cfg.gpu_timeout_ms); }
+    bool completed(ID3D12Fence *fence, UINT64 value) const {
+        return nr_external_provider_completion::Wait(fence, g.fence_event, value, timeout()) ==
+            nr_external_provider_completion::Result::Complete;
+    }
+    bool SignalInput(UINT64 n) { return g.rs_queue->signal(g.rs_fence_in, n); }
+    bool WaitInput(UINT64 n) { return completed(g.fence12_in, n); }
+    bool QueueWaitInput(UINT64 n) { return SUCCEEDED(g.queue->Wait(g.fence12_in, n)); }
+    UINT64 End() { return EndCommands(); }
+    bool WaitSubmitted(UINT64 n) { return completed(g.fence12, n); }
+    bool SignalOutput(UINT64 n) { return SUCCEEDED(g.queue->Signal(g.fence12_out, n)); }
+    bool WaitOutput(UINT64 n) { return completed(g.fence12_out, n); }
+    bool WaitImportedOutput(UINT64 n) { return FeedVkWaitTimeline(&g.vk, g.vk_sem_out, n, timeout()); }
+    bool QueueWaitOutput(UINT64 n) { return g.rs_queue->wait(g.rs_fence_out, n); }
+};
+
+static bool NrFeedVkRecord(UINT64 n, int reset)
+{
+    // Keep the transport bytes unchanged, and decode SDR into the private FP16
+    // pair on this same LUID-matched device/list before submitting to Core.
+    if (g.in_buf12[SLOT_COLOR]) {
+        const struct { int slot; DXGI_FORMAT fmt; } fill[] = {
+            {SLOT_COLOR, g.color_fmt}, {SLOT_DEPTH, DXGI_FORMAT_R32_FLOAT},
+            {SLOT_MV, DXGI_FORMAT_R16G16_FLOAT}, {SLOT_MASK, DXGI_FORMAT_R8_UNORM}
+        };
+        for (const auto &d : fill) {
+            if (!g.in_buf12[d.slot] || (d.slot == SLOT_MASK && !g.mask_ok)) continue;
+            D3D12_TEXTURE_COPY_LOCATION src{}, dst{};
+            src.pResource = g.in_buf12[d.slot]; src.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+            src.PlacedFootprint.Footprint = {d.fmt, g.width, g.height, 1, g.in_pitch[d.slot]};
+            dst.pResource = g.tex12[d.slot]; dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+            Barrier(g.in_buf12[d.slot], D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_COPY_SOURCE);
+            Barrier(g.tex12[d.slot], D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_COPY_DEST);
+            g.list->CopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
+            Barrier(g.tex12[d.slot], D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_COMMON);
+            Barrier(g.in_buf12[d.slot], D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_COMMON);
+        }
+    }
+    for (int slot : {SLOT_COLOR, SLOT_DEPTH, SLOT_MV})
+        Barrier(g.tex12[slot], D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    GuideProbeRecord(g.tex12[SLOT_MV], D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+                     g.tex12[SLOT_DEPTH], D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    FeedVkProbeD12(false);
+    auto &color = nr_external_provider_vk_color::adapter;
+    color.Decode(g.list, g.in_buf12[SLOT_COLOR]);
+
+    nr_external_provider_feeder::FeedInputs input{};
+    input.command_list = reinterpret_cast<std::uint64_t>(g.list);
+    input.queue = reinterpret_cast<std::uint64_t>(g.queue);
+    input.fence = reinterpret_cast<std::uint64_t>(g.fence12);
+    input.fence_value = g.fence_value + 1; // exact value NrFeedVkSyncOps::End will signal
+    input.output_format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+    input.color = reinterpret_cast<std::uint64_t>(color.input);
+    input.output = reinterpret_cast<std::uint64_t>(color.output);
+    input.depth = reinterpret_cast<std::uint64_t>(g.tex12[SLOT_DEPTH]);
+    input.motion = reinterpret_cast<std::uint64_t>(g.tex12[SLOT_MV]);
+    input.width = g.width; input.height = g.height;
+    input.color_format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+    input.depth_format = DXGI_FORMAT_R32_FLOAT;
+    input.motion_format = DXGI_FORMAT_R16G16_FLOAT;
+    input.color_state = input.depth_state = input.motion_state = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+    input.output_state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    input.mv_scale_x = g_cfg.mv_scale_x; input.mv_scale_y = g_cfg.mv_scale_y;
+    input.depth_inverted = g_cfg.depth_inverted >= 0 ? g_cfg.depth_inverted != 0 : g.depth_reversed;
+    input.hdr_color = false; // confirmed SDR, decoded to linear light; not an HDR admission override
+    input.pre_exposure = input.exposure_scale = 1.0f;
+    input.reset = reset != 0;
+    input.view_id = 2; // Vulkan synthetic view; distinct from FeedFrame12.
+    input.epoch = nr_external_resource_epoch;
+    static std::uint64_t sequence = 0;
+    input.frame_id = ++sequence;
+    NrExternalFrameV1 frame{}; NrExternalSubmitResultV1 result{};
+    const bool transferred = nr_external_provider_client::Claim(kNrExternalProviderIdDl5f) &&
+        nr_external_provider_feeder::BuildSyntheticFrame(input, frame) &&
+        nr_external_provider_client::Submit(frame, result) && result.writeback_performed;
+    if (!transferred && (n <= 8 || n % 600 == 0))
+        Log("[feed] Vulkan project Core retained original: %s (no private Feature1/SR fallback)",
+            result.bypass[0] ? result.bypass : "consumer unavailable");
+    color.Finish(g.list, g.in_buf12[SLOT_COLOR], g.home_buf12, transferred);
+    if (transferred && g_vk_probe.active) {
+        // D is now the encoded Core output, comparable byte-for-byte with C/E/F.
+        // Sample the existing bounded 3x16x16 probe; no per-frame CPU download.
+        Barrier(color.packed, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_SOURCE);
+        for (UINT t = 0; t < 3; ++t) for (UINT y = 0; y < kVkProbeSide; ++y) {
+            const UINT x = g.width * (t + 1) / 4 - kVkProbeSide / 2;
+            const UINT sy = g.height * (t + 1) / 4 - kVkProbeSide / 2 + y;
+            g.list->CopyBufferRegion(g_vk_probe.d12, kVkProbeStage + t * kVkProbeTile + y * kVkProbePitch,
+                color.packed, static_cast<UINT64>(sy) * g.home_pitch + x * 4, kVkProbeSide * 4);
+        }
+        Barrier(color.packed, D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    }
+    for (int slot : {SLOT_COLOR, SLOT_DEPTH, SLOT_MV})
+        Barrier(g.tex12[slot], D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COMMON);
+    // Even a decline must submit: real ExecuteCommandLists trains Core affinity.
+    // The caller completes this list before reacquiring the imports or copying home.
+    return transferred;
+}
