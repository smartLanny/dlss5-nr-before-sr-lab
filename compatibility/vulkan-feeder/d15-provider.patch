+// SM5 compute works with raw buffers and FP16 UAVs. There is deliberately no
+// BGRA UAV, sRGB UAV, sampler conversion or CPU readback in either direction.
+inline constexpr char kShader[] = R"hlsl(
+cbuffer Extent : register(b0) { uint width; uint height; uint input_pitch; uint output_pitch; uint bgra; };
+ByteAddressBuffer packed_input : register(t1);
+Texture2D<float4> linear_output : register(t0);
+RWTexture2D<float4> linear_input : register(u0);
+RWByteAddressBuffer packed_output : register(u1);
+float DecodeChannel(float x) { return x <= 0.04045 ? x / 12.92 : pow((x + 0.055) / 1.055, 2.4); }
+float EncodeChannel(float x) { x = saturate(x); return x <= 0.0031308 ? x * 12.92 : 1.055 * pow(x, 1.0 / 2.4) - 0.055; }
+[numthreads(8,8,1)] void Decode(uint3 id : SV_DispatchThreadID) {
+    if (id.x >= width || id.y >= height) return;
+    uint packed = packed_input.Load(id.y * input_pitch + id.x * 4);
+    float4 c = float4(packed & 255, (packed >> 8) & 255, (packed >> 16) & 255, packed >> 24) / 255.0;
+    if (bgra != 0) c.rgb = c.bgr;
+    linear_input[id.xy] = float4(DecodeChannel(c.r), DecodeChannel(c.g), DecodeChannel(c.b), c.a);
+}
+[numthreads(8,8,1)] void Encode(uint3 id : SV_DispatchThreadID) {
+    if (id.x >= width || id.y >= height) return;
+    uint original = packed_input.Load(id.y * input_pitch + id.x * 4);
+    float3 c = linear_output.Load(int3(id.xy,0)).rgb;
+    if (any(isnan(c)) || any(isinf(c))) { packed_output.Store(id.y * output_pitch + id.x * 4, original); return; }
+    c = float3(EncodeChannel(c.r), EncodeChannel(c.g), EncodeChannel(c.b));
+    if (bgra != 0) c = c.bgr;
+    uint3 bytes = (uint3)floor(saturate(c) * 255.0 + 0.5);
+    // NR does not own alpha. Preserve the source's original alpha byte exactly.
+    packed_output.Store(id.y * output_pitch + id.x * 4, bytes.r | (bytes.g << 8) | (bytes.b << 16) | (original & 0xff000000));
