+#pragma once
+#include <cstdint>
+
+// The first Vulkan provider route deliberately confirms each cross-API handoff
+// before queuing the next one. Never enqueue an unsatisfiable wait on the game
+// queue, and never confuse recorded Core output with completed output.
+namespace nr_external_provider_vk_sync {
+enum class Result {
+    Complete, InputSignal, InputCompletion, InputQueueWait, Submit,
+    SubmitCompletion, OutputSignal, OutputCompletion, ImportedCompletion,
+    OutputQueueWait
+};
+inline const char *Name(Result r) {
+    switch (r) {
+    case Result::Complete: return "complete";
+    case Result::InputSignal: return "Vulkan input signal failed";
+    case Result::InputCompletion: return "Vulkan input completion unconfirmed";
+    case Result::InputQueueWait: return "D3D12 input queue wait failed";
+    case Result::Submit: return "D3D12 command submission failed";
+    case Result::SubmitCompletion: return "D3D12 Core completion unconfirmed";
+    case Result::OutputSignal: return "D3D12 output signal failed";
+    case Result::OutputCompletion: return "D3D12 output completion unconfirmed";
+    case Result::ImportedCompletion: return "Vulkan imported output completion unconfirmed";
+    case Result::OutputQueueWait: return "Vulkan output queue wait failed";
+    }
+    return "Vulkan transport failed";
+}
+template<class Ops> Result Input(Ops &ops, std::uint64_t frame) {
+    if (!ops.SignalInput(frame)) return Result::InputSignal;
+    if (!ops.WaitInput(frame)) return Result::InputCompletion;
+    if (!ops.QueueWaitInput(frame)) return Result::InputQueueWait;
+    return Result::Complete;
+}
+template<class Ops> Result Output(Ops &ops, std::uint64_t frame) {
+    const auto submitted = ops.End();
+    if (!submitted) return Result::Submit;
+    if (!ops.WaitSubmitted(submitted)) return Result::SubmitCompletion;
+    if (!ops.SignalOutput(frame)) return Result::OutputSignal;
+    if (!ops.WaitOutput(frame)) return Result::OutputCompletion;
+    if (!ops.WaitImportedOutput(frame)) return Result::ImportedCompletion;
+    if (!ops.QueueWaitOutput(frame)) return Result::OutputQueueWait;
+    return Result::Complete;
+}
+}
