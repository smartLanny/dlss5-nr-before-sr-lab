+// effect_runtime has no color-space getter in the pinned SDK. Bind the real
+// swapchain via its actual back buffers; never cast an effect_runtime to it.
+inline SRWLOCK swapchain_lock = SRWLOCK_INIT;
+inline reshade::api::swapchain *swapchains[128]{};
+inline void RememberSwapchain(reshade::api::swapchain *swapchain, bool) {
+    if (!swapchain || swapchain->get_device()->get_api() != reshade::api::device_api::vulkan) return;
+    AcquireSRWLockExclusive(&swapchain_lock);
+    for (auto *entry : swapchains) if (entry == swapchain) { ReleaseSRWLockExclusive(&swapchain_lock); return; }
+    for (auto &entry : swapchains) if (!entry) { entry = swapchain; break; }
+    ReleaseSRWLockExclusive(&swapchain_lock);
+}
+inline void ForgetSwapchain(reshade::api::swapchain *swapchain, bool) {
+    AcquireSRWLockExclusive(&swapchain_lock);
+    for (auto &entry : swapchains) if (entry == swapchain) entry = nullptr;
+    ReleaseSRWLockExclusive(&swapchain_lock);
+}
+inline reshade::api::color_space ColorSpace(reshade::api::effect_runtime *runtime) {
+    auto result = reshade::api::color_space::unknown;
+    if (!runtime) return result;
+    const auto count = runtime->get_back_buffer_count();
+    if (!count || count > 64) return result;
+    unsigned matched = 0;
+    AcquireSRWLockShared(&swapchain_lock);
+    for (auto *swapchain : swapchains) {
+        if (!swapchain || swapchain->get_device() != runtime->get_device() || swapchain->get_back_buffer_count() != count) continue;
+        bool same = true;
+        for (std::uint32_t i = 0; i < count; ++i)
+            if (swapchain->get_back_buffer(i).handle != runtime->get_back_buffer(i).handle) { same = false; break; }
+        if (same) { result = swapchain->get_color_space(); ++matched; }
+    }
+    ReleaseSRWLockShared(&swapchain_lock);
+    return matched == 1 ? result : reshade::api::color_space::unknown;
+}
