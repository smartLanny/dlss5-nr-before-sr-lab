+// SDR adapter for the Vulkan provider. The game's packed bytes stay packed
+// across the external-memory transport. Only the private, LUID-matched D3D12
+// device sees the linear FP16 textures consumed by the project Core.
+namespace nr_external_provider_vk_color {
+enum class Layout { Unsupported, Rgba8, Bgra8 };
+inline Layout Classify(DXGI_FORMAT format, reshade::api::color_space color_space) noexcept {
+    if (color_space != reshade::api::color_space::srgb_nonlinear) return Layout::Unsupported;
+    switch (format) {
+    case DXGI_FORMAT_R8G8B8A8_TYPELESS:
+    case DXGI_FORMAT_R8G8B8A8_UNORM:
+    case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB: return Layout::Rgba8;
+    case DXGI_FORMAT_B8G8R8A8_TYPELESS:
+    case DXGI_FORMAT_B8G8R8A8_UNORM:
+    case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB: return Layout::Bgra8;
+    default: return Layout::Unsupported;
+    }
+}
