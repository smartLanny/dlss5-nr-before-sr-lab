// D13 region regression: production Prepare -> Seal -> Dispatch on real
// ReShade/WARP D3D12 resources.  The provider is absent; the region shader is
// the production shader and all descriptor packets come from the production
// nr_binding runtime.  A queue Wait fence holds several command lists in
// flight so a same-input Seal must reuse an immutable packet while a changed
// input takes another packet.
// Native/Create registry and Reset publication are controlled services. Real
// notifier registration does not exercise the production native-death consumer.
#define WIN32_LEAN_AND_MEAN
#define NOMINMAX
#define CINTERFACE
#define COBJMACROS
#define WIDL_C_INLINE_WRAPPERS
#include <windows.h>
#include <d3d12.h>
#include <dxgi1_6.h>
#include <d3dcompiler.h>
#include <atomic>
// These are recording-boundary notifications, not synthetic source ownership
// or route admission. The real frame/route ledgers have independent fixtures.
namespace nr_source_runtime {
std::atomic<unsigned> recording_notifications{0};
void MarkPrivateRecorded() { ++recording_notifications; }
}
namespace nr_processing_runtime {
std::atomic<unsigned> recording_notifications{0};
void MarkRecorded() { ++recording_notifications; }
}
