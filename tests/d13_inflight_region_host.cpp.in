template<class T> void ReleaseCom(T *&p) noexcept {
    if (p != nullptr) p->lpVtbl->Release(p);
    p = nullptr;
}
#define IUnknown_QueryInterface(p, i, o) (p)->lpVtbl->QueryInterface(p, i, o)
std::atomic<unsigned long long> g_rr_depth_proxy_matches{0};
// @CORE_DEVICE_IDENTITY@
#undef IUnknown_QueryInterface

// The production inlines use the COBJMACROS spelling.  Keeping these wrappers
// explicit makes the fixture compile with the official ReShade SDK ABI.
#define ID3D12Resource_GetDevice(p, i, o) (p)->lpVtbl->GetDevice(p, i, o)
#define ID3D12Resource_AddRef(p) (p)->lpVtbl->AddRef(p)
#define ID3D12Device_AddRef(p) (p)->lpVtbl->AddRef(p)
#define ID3D12Device_GetDescriptorHandleIncrementSize(p, t) (p)->lpVtbl->GetDescriptorHandleIncrementSize(p, t)
#define ID3D12Device_CreateDescriptorHeap(p, d, i, o) (p)->lpVtbl->CreateDescriptorHeap(p, d, i, o)
#define ID3D12Device_CreateShaderResourceView(p, r, d, h) (p)->lpVtbl->CreateShaderResourceView(p, r, d, h)
#define ID3D12Device_CreateUnorderedAccessView(p, r, c, d, h) (p)->lpVtbl->CreateUnorderedAccessView(p, r, c, d, h)
#define ID3D12Device_CreateCommittedResource(p, h, f, d, s, c, i, o) (p)->lpVtbl->CreateCommittedResource(p, h, f, d, s, c, i, o)
#define ID3D12Device_CheckFeatureSupport(p, t, d, s) (p)->lpVtbl->CheckFeatureSupport(p, t, d, s)
#define ID3D12GraphicsCommandList_GetPrivateData(p, g, s, d) (p)->lpVtbl->GetPrivateData(p, g, s, d)
#define ID3D12GraphicsCommandList_SetPrivateData(p, g, s, v) (p)->lpVtbl->SetPrivateData(p, g, s, v)
#define ID3D12GraphicsCommandList_ResourceBarrier(p, n, b) (p)->lpVtbl->ResourceBarrier(p, n, b)
#define ID3D12GraphicsCommandList_SetDescriptorHeaps(p, n, h) (p)->lpVtbl->SetDescriptorHeaps(p, n, h)
#define ID3D12GraphicsCommandList_SetComputeRootSignature(p, r) (p)->lpVtbl->SetComputeRootSignature(p, r)
#define ID3D12GraphicsCommandList_SetComputeRootDescriptorTable(p, i, h) (p)->lpVtbl->SetComputeRootDescriptorTable(p, i, h)
#define ID3D12GraphicsCommandList_SetComputeRoot32BitConstants(p, i, n, v, o) (p)->lpVtbl->SetComputeRoot32BitConstants(p, i, n, v, o)
#define ID3D12GraphicsCommandList_SetPipelineState(p, s) (p)->lpVtbl->SetPipelineState(p, s)
#define ID3D12GraphicsCommandList_Dispatch(p, x, y, z) (p)->lpVtbl->Dispatch(p, x, y, z)
#define ID3D12GraphicsCommandList_CopyTextureRegion(p, d, x, y, z, s, b) (p)->lpVtbl->CopyTextureRegion(p, d, x, y, z, s, b)
#define ID3D12GraphicsCommandList_Close(p) (p)->lpVtbl->Close(p)
#define ID3D12CommandQueue_ExecuteCommandLists(p, n, l) (p)->lpVtbl->ExecuteCommandLists(p, n, l)
#define ID3D12CommandQueue_Signal(p, f, v) (p)->lpVtbl->Signal(p, f, v)
#define ID3D12CommandQueue_Wait(p, f, v) (p)->lpVtbl->Wait(p, f, v)
#define ID3D12CommandQueue_GetDevice(p, i, o) (p)->lpVtbl->GetDevice(p, i, o)
#define ID3D12Fence_GetCompletedValue(p) (p)->lpVtbl->GetCompletedValue(p)
#define ID3D12Fence_SetEventOnCompletion(p, v, e) (p)->lpVtbl->SetEventOnCompletion(p, v, e)
#define ID3D12Resource_Map(p, s, r, d) (p)->lpVtbl->Map(p, s, r, d)
#define ID3D12Resource_Unmap(p, s, r) (p)->lpVtbl->Unmap(p, s, r)
