    unsigned long long identity = 0;
    unsigned int stable_submissions = 0;
    unsigned int flags = 0;
};
constexpr unsigned int kQueueMarkerMigrated = 1u;
constexpr unsigned int kRequiredStableQueueSubmissions = 2u;
