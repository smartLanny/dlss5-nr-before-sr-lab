using nr_ui_activity::Count;
thread_local Count test_now=0;
thread_local unsigned window_lock_depth=0;
thread_local bool read_pending_tick=false;
std::atomic<unsigned> lock_violations{0};
std::atomic<bool> parallel_clock{false};
std::atomic<Count> monotonic_tick{100};
ULONGLONG UiFixtureTick() {
    if(read_pending_tick&&window_lock_depth!=1)++lock_violations;
    read_pending_tick=false;
    return parallel_clock.load()?monotonic_tick.fetch_add(1):test_now;
}
void UiFixtureAcquireExclusive(PSRWLOCK lock);
void UiFixtureReleaseExclusive(PSRWLOCK lock);
void UiFixtureAcquireShared(PSRWLOCK lock);
#define AcquireSRWLockExclusive UiFixtureAcquireExclusive
#define ReleaseSRWLockExclusive UiFixtureReleaseExclusive
#define AcquireSRWLockShared UiFixtureAcquireShared
#define GetTickCount64 UiFixtureTick
#include "nr_ui_activity_runtime.inl"
#undef AcquireSRWLockExclusive
#undef ReleaseSRWLockExclusive
#undef AcquireSRWLockShared
void UiFixtureAcquireExclusive(PSRWLOCK lock) {
    if(lock==&g_nr_ui_activity_lock&&window_lock_depth)++lock_violations;
    AcquireSRWLockExclusive(lock);
    if(lock==&g_nr_ui_activity_window_lock)++window_lock_depth;
}
void UiFixtureReleaseExclusive(PSRWLOCK lock) {
    if(lock==&g_nr_ui_activity_window_lock)--window_lock_depth;
    ReleaseSRWLockExclusive(lock);
}
void UiFixtureAcquireShared(PSRWLOCK lock) {
    if(lock==&g_nr_ui_activity_lock&&window_lock_depth)++lock_violations;
    AcquireSRWLockShared(lock);
}
struct ReadCounter {
    std::atomic<Count> value{0};
    std::atomic<unsigned> reads{0};
    bool change_on_second=false;
    Count load(std::memory_order order=std::memory_order_seq_cst) {
        if(window_lock_depth!=1)++lock_violations;
        read_pending_tick=true;
        const auto call=reads.fetch_add(1,std::memory_order_relaxed)+1;
        return value.load(order)+(change_on_second && call==2?1u:0u);
    }
    void Reset(Count next) {value=next;reads=0;change_on_second=false;}
};
ReadCounter g_pipeline_stats_epoch,g_config_generation,g_carrier_evaluations,g_nr_successful_evaluations;
ReadCounter g_nr_transfer_submitted_frames,g_queue_affinity_unknown_bypass_frames,g_last_bypass_reason;
