thread_local Count test_now=0;
ULONGLONG UiFixtureTick() {return test_now;}
#define GetTickCount64 UiFixtureTick
#include "nr_ui_activity_runtime.inl"
struct ReadCounter {
    std::atomic<Count> value{0};
    std::atomic<unsigned> reads{0};
    bool change_on_second=false;
    Count load(std::memory_order order=std::memory_order_seq_cst) {
        const auto call=reads.fetch_add(1,std::memory_order_relaxed)+1;
        return value.load(order)+(change_on_second && call==2?1u:0u);
    }
    void Reset(Count next) {value=next;reads=0;change_on_second=false;}
};
ReadCounter g_pipeline_stats_epoch,g_config_generation,g_carrier_evaluations,g_nr_successful_evaluations;
ReadCounter g_nr_transfer_submitted_frames,g_queue_affinity_unknown_bypass_frames,g_last_bypass_reason;
enum class BypassReason { None,QueueRetirementTimeout,RuntimeUnavailable,CodecUnavailable,
    RayReconstructionGuard,ShortFuseOwnsNr,GenericRenoDxConflict,WaitingForFeature1,
    ModuleObserverInstalling,ModuleObserverUncertain,CommandStateUnverified,Other };
