HookFailure SnapshotNgxHookFailure() {return {};}
struct CommandEvidence {bool available=false;const char* reason="none";bool guard_requested=false,guard_covered=false,fresh_reset=false;Count sampled_at=0;};
CommandEvidence SnapshotCommandStateEvidence() {return {};}
std::vector<std::string> drawn;
