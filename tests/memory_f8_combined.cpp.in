std::map<std::wstring,std::string> summaries;
std::wstring Beside(const wchar_t* path,const wchar_t* leaf){return (std::filesystem::path(path).parent_path()/leaf).wstring();}
bool ReadSummary(const wchar_t* path,std::string& text,bool& coverage,ULONGLONG){
    auto found=summaries.find(path);if(found==summaries.end())return false;
    text=found->second;coverage=true;return text.size()<=nr_feedback_text::kSummaryLimit;
}
void WideToUtf8(const wchar_t* source,char* dest,std::size_t capacity){
    const std::wstring wide(source);const std::string text(wide.begin(),wide.end());
    std::snprintf(dest,capacity,"%s",text.c_str());
}
