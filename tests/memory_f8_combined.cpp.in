std::string Read(const std::filesystem::path& path){std::ifstream in(path,std::ios::binary);return {std::istreambuf_iterator<char>(in),{}};}
void Write(const std::filesystem::path& path,const std::string& text){std::ofstream out(path,std::ios::binary);out.write(text.data(),text.size());Check(out.good(),"HOST_FIXTURE_WRITE");}

