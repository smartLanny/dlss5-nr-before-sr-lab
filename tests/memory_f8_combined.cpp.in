bool WriteAtomic(const wchar_t* directory,const std::string& text,Output& out,const wchar_t* name){
    const auto path=std::filesystem::path(directory)/name;
    const auto temporary=path.string()+".partial";
    Write(temporary,text);std::filesystem::rename(temporary,path);out.path=path.wstring();return true;
}
}
