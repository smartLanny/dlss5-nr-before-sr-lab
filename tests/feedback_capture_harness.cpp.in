namespace reshade::api {
enum class device_properties { description,driver_version,vendor_id };
struct resource_desc { struct { unsigned format=28; } texture; };
struct device {
    bool get_property(device_properties p,void *out) {
        if(p==device_properties::description)std::strcpy(static_cast<char *>(out),"Fixture GPU");
        else *static_cast<uint32_t *>(out)=p==device_properties::vendor_id?0x10de:123;
        return true;
    }
    unsigned get_api() {return 12;}
    // ReShade's MSVC structure returns do not share the addon MinGW ABI.
    // F8 diagnostics must stay on the pointer/scalar event-snapshot seam.
    resource_desc get_resource_desc(unsigned)=delete;
};
struct effect_runtime {
    device d;
    std::vector<std::string> requested;
    bool deliver=true;
    device *get_device() {return &d;}
    void get_screenshot_width_and_height(uint32_t *w,uint32_t *h) {*w=1920;*h=1080;}
    unsigned get_current_back_buffer()=delete;
    void save_screenshot(const char *tag);
};
}
namespace reshade::internal { static HMODULE get_reshade_module_handle() {return nullptr;} }

