static BOOL RealCreateDirectory(const wchar_t *path) {return CreateDirectoryW(path,nullptr);}

static ULONGLONG fake_now=1000;
static bool pin_ok=true,queue_ok=true,create_directory_ok=true;
enum class DirectoryFailure { None,DocumentsLookup,DocumentsRoot,DocumentsSession,BothRoots,TempTooLong };
static DirectoryFailure directory_failure=DirectoryFailure::None;
static unsigned documents_calls=0,temp_calls=0;
static bool documents_root_exists=false;
static std::vector<std::wstring> directory_attempts;
static HRESULT FakeDocuments(HWND,int,HANDLE,DWORD,LPWSTR path) {
    ++documents_calls;
    if(directory_failure==DirectoryFailure::DocumentsLookup||directory_failure==DirectoryFailure::TempTooLong)return E_FAIL;
    std::wcscpy(path,L"C:\\fixture-documents");return S_OK;
}
static DWORD FakeTemp(DWORD capacity,LPWSTR path) {
    ++temp_calls;
    if(directory_failure==DirectoryFailure::TempTooLong)return capacity;
    std::wcscpy(path,L"C:\\fixture-temp\\");return static_cast<DWORD>(std::wcslen(path));
}
static BOOL FakeCreateDirectory(LPCWSTR path,LPSECURITY_ATTRIBUTES) {
    directory_attempts.emplace_back(path);
    const std::wstring value=path,documents_root=L"C:\\fixture-documents\\DLSS5-Feedback";
    const bool is_document=value.rfind(documents_root,0)==0;
    if(!create_directory_ok||directory_failure==DirectoryFailure::BothRoots||
        (is_document&&directory_failure==DirectoryFailure::DocumentsRoot&&value==documents_root)||
        (is_document&&directory_failure==DirectoryFailure::DocumentsSession&&value!=documents_root)) {
        SetLastError(ERROR_ACCESS_DENIED);return FALSE;
    }
    if(documents_root_exists&&value==documents_root) {SetLastError(ERROR_ALREADY_EXISTS);return FALSE;}
    return TRUE;
}
static unsigned queue_calls=0,pin_calls=0,stage_calls=0;
static LPTHREAD_START_ROUTINE queued_worker=nullptr;
static void *queued_parameter=nullptr;
static std::function<void()> tick;
static std::function<void()> during_pin;
static ULONGLONG FakeTick() { return fake_now; }
static void FakeSleep(DWORD amount) { fake_now+=amount;if(tick)tick(); }
static BOOL FakePin(DWORD,LPCWSTR,HMODULE *module) {
    ++pin_calls;
    if(during_pin) {auto callback=std::move(during_pin);during_pin={};callback();}
    *module=reinterpret_cast<HMODULE>(1);return pin_ok;
}
static BOOL FakeQueue(LPTHREAD_START_ROUTINE worker,void *parameter,ULONG) {
    ++queue_calls;if(!queue_ok)return FALSE;
    queued_worker=worker;queued_parameter=parameter;return TRUE;
}
