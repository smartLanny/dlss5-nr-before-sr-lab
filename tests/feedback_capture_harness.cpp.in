namespace nr_bundle {
enum class Status { Failed,Complete,Partial };
enum class FileKind { Copy,LogTail,HashOnly };
struct Entry {std::wstring source;std::string name,reason;bool required;};
struct Job {std::string metadata;std::vector<Entry> entries;};
struct Result {
    Status status=Status::Failed;DWORD win32_error=0;wchar_t zip_path[1024]={};
    unsigned included_files=0,hashed_modules=0,missing_files=0,truncated_files=0;
    bool required_complete=true;
};
static unsigned created=0,destroyed=0,runs=0;
static bool allocation_ok=true,run_ok=true;
static Job last;
static std::function<void()> during_run;
static Job *CreateJob(const wchar_t *,const char *text) {
    if(!allocation_ok||std::strlen(text)>=32768||
        MultiByteToWideChar(CP_UTF8,MB_ERR_INVALID_CHARS,text,-1,nullptr,0)==0)return nullptr;
    ++created;return new Job{text,{}};
}
static bool AddFile(Job &job,const wchar_t *source,const char *name,FileKind,bool required=false,unsigned long long=0) {
    job.entries.push_back({source,name,"",required});return true;
}
static bool AddMissing(Job &job,const char *name,const char *reason,bool required=false) {
    job.entries.push_back({L"",name,reason,required});return true;
}
static Result Run(Job &job) {
    ++runs;if(during_run)during_run();last=job;Result r;
    if(!run_ok)return r;
    r.status=Status::Complete;wcscpy_s(r.zip_path,L"C:\\fixture\\feedback.zip");
    for(const auto &e:job.entries) {
        if(e.reason.empty())++r.included_files;
        else {++r.missing_files;r.status=Status::Partial;if(e.required)r.required_complete=false;}
    }
    return r;
}
static void DestroyJob(Job *job) {++destroyed;delete job;}
}
static void FeedbackAddModules(nr_bundle::Job &,FeedbackSession &) {}
static void FeedbackAddLogBeside(nr_bundle::Job &,const wchar_t *,const wchar_t *,const char *,bool) {}

