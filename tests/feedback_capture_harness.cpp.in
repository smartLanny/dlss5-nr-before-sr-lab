void reshade::api::effect_runtime::save_screenshot(const char *tag) {
    requested.emplace_back(tag);
    if(deliver)OnFeedbackScreenshot(this,(std::string("C:\\fixture\\game ")+tag+".png").c_str());
}

static unsigned checks=0,failures=0;
static void Check(bool ok,const char *message) {
    ++checks;if(!ok){++failures;std::printf("FAIL %s\n",message);}
}
static void Reset() {
    Check(g_feedback_session==nullptr&&queued_worker==nullptr,"previous session/queued worker cleaned up");
    g_feedback_requested=false;g_feedback_status=0;g_feedback_last_zip[0]=0;
    fake_now+=100000;tick={};during_pin={};pin_ok=queue_ok=create_directory_ok=true;
    directory_failure=DirectoryFailure::None;documents_calls=temp_calls=0;
    documents_root_exists=false;directory_attempts.clear();
    queue_calls=pin_calls=stage_calls=0;stage_available=true;during_stage_request={};
    config={};fixture_bypass="fixture";g_nr_successful_evaluations=10;g_nr_transfer_submitted_frames=8;
    nr_bundle::created=nr_bundle::destroyed=nr_bundle::runs=0;
    nr_bundle::allocation_ok=nr_bundle::run_ok=true;nr_bundle::last={};nr_bundle::during_run={};
}
static void RunWorker() {
    auto fn=queued_worker;auto *p=queued_parameter;queued_worker=nullptr;queued_parameter=nullptr;
    Check(fn!=nullptr,"collector queued worker exists");if(fn)Check(fn(p)==0,"worker returns normally");
    Check(g_feedback_session==nullptr,"worker removes shared session before completion");
    Check(nr_bundle::created==nr_bundle::destroyed,"every packaging job destroyed");
}
static const nr_bundle::Entry *Find(const char *name) {
    for(const auto &e:nr_bundle::last.entries)if(e.name==name)return &e;return nullptr;
}
static std::string Tag(unsigned i) {
    return std::string(g_feedback_session->postfix)+"_"+std::to_string(i);
}
static void TestCallbacks() {
    Reset();reshade::api::effect_runtime r,other;r.deliver=false;
    Check(RequestFeedbackBundle(),"first F8 accepted");
    Check(!RequestFeedbackBundle(),"second queued F8 rejected");
    FeedbackPresent(&r);
    Check(queue_calls==1&&pin_calls==1&&stage_calls==1,"one process-pinned worker and one stage request");
    Check(!RequestFeedbackBundle(),"F8 during collection rejected");
    const auto original=Tag(0),unrequested=Tag(2);
    const auto exact=std::string("C:\\fixture\\game ")+original+".png";
    OnFeedbackScreenshot(&other,exact.c_str());Check(g_feedback_session->screenshots[0][0]==0,"wrong runtime rejected");
    OnFeedbackScreenshot(&r,"C:\\fixture\\other.png");Check(g_feedback_session->screenshots[0][0]==0,"wrong session tag rejected");
    OnFeedbackScreenshot(&r,(std::string("C:\\fixture\\game ")+original+"1.png").c_str());
    Check(g_feedback_session->screenshots[0][0]==0,"tag prefix _0 must not match _01");
    g_feedback_session->screenshots[0][0]=0;
    OnFeedbackScreenshot(&r,(std::string("C:\\fixture\\")+original+"\\unrelated.png").c_str());
    Check(g_feedback_session->screenshots[0][0]==0,"tag in parent directory must not match image basename");
    g_feedback_session->screenshots[0][0]=0;
    OnFeedbackScreenshot(&r,(std::string("C:\\fixture\\game ")+unrequested+".png").c_str());
    Check(g_feedback_session->screenshots[2][0]==0,"callback for not-yet-requested image rejected");
    g_feedback_session->screenshots[2][0]=0;
    OnFeedbackScreenshot(&r,exact.c_str());
    Check(g_feedback_session->screenshots[0][0]!=0,"exact requested screenshot accepted");
    const std::wstring first=g_feedback_session->screenshots[0];
    OnFeedbackScreenshot(&r,(std::string("C:\\fixture\\second ")+original+".png").c_str());
    Check(first==g_feedback_session->screenshots[0],"duplicate callback cannot overwrite first saved image");
    FeedbackStageExported(g_stage_capture_request_id+1,L"C:\\wrong-stage",true);
    Check(!g_feedback_session->stage_finished,"wrong stage request rejected");
    FeedbackStageExported(g_stage_capture_request_id,L"C:\\right-stage",true);
    Check(g_feedback_session->stage_ok&&std::wstring(g_feedback_session->stage_directory)==L"C:\\right-stage","same request stage directory accepted");
    const auto request=g_stage_capture_request_id.load();
    nr_bundle::during_run=[&] {
        Check(g_feedback_status==2&&!RequestFeedbackBundle(),"F8 during packaging rejected");
        OnFeedbackScreenshot(&r,exact.c_str());FeedbackStageExported(request,L"C:\\late-stage",true);
        Check(g_feedback_session==nullptr,"callbacks during packaging cannot recover frozen session");
    };
    RunWorker();
    Check(g_feedback_status==4&&nr_bundle::runs==1,"missing images still produce one partial bundle");
    const auto *stage=Find("stages/original.pfm");
    Check(stage&&stage->source==L"C:\\right-stage\\original.pfm","late stage cannot replace frozen exact request directory");
    Check(Find("screenshots/current-1")&&Find("screenshots/current-2"),"unreceived screenshots explicitly missing");
    OnFeedbackScreenshot(&r,exact.c_str());FeedbackStageExported(request,L"C:\\after-complete",true);
    Check(g_feedback_session==nullptr,"late callbacks after delete safely ignored");
}
static void TestReadyAndZeroNr(bool nr_enabled,bool prior_success) {
    Reset();reshade::api::effect_runtime r;
    config.enabled=nr_enabled;g_nr_successful_evaluations=prior_success?10:0;
    RequestFeedbackBundle();FeedbackPresent(&r);
    const auto start=fake_now;const bool stage_expected=nr_enabled&&prior_success;
    Check(stage_calls==(stage_expected?1u:0u),"disabled/never-success NR does not request stage or enable NR");
    tick=[&] {
        FeedbackPresent(&r);
        if(stage_expected&&fake_now-start>=1000)FeedbackStageExported(g_stage_capture_request_id,L"C:\\complete",true);
    };
    RunWorker();
    Check(fake_now-start==5000,"ready collection observes minimum 5-second boundary");
    Check(r.requested.size()==3,"exactly three screenshot requests made by actual Present");
    Check(g_feedback_status==(stage_expected?3u:4u),"required completeness determines final UI state");
    Check(nr_bundle::runs==1,"zero-NR and successful NR both call packager");
    Check(config.enabled==nr_enabled,"collector leaves user's enabled setting unchanged");
    const auto *stage=Find("stages");
    Check(stage_expected?!stage:(stage&&!stage->reason.empty()),"zero-NR stage has explicit missing reason");
}
static void TestTimeoutAndNextSession() {
    Reset();reshade::api::effect_runtime r;r.deliver=false;
    RequestFeedbackBundle();FeedbackPresent(&r);
    const auto old_tag=Tag(0);const auto old_request=g_stage_capture_request_id.load();const auto start=fake_now;
    tick=[&]{FeedbackPresent(&r);};RunWorker();
    Check(fake_now-start==30000,"missing GPU and screenshot callbacks time out at 30 seconds");
    Check(Find("stages")&&!Find("stages")->reason.empty(),"GPU timeout packaged with missing-stage reason");
    Check(g_feedback_status==4,"timeout yields usable partial bundle");
    tick={};nr_bundle::during_run={};
    Check(RequestFeedbackBundle(),"new F8 accepted after timeout completion");FeedbackPresent(&r);
    OnFeedbackScreenshot(&r,(std::string("C:\\fixture\\game ")+old_tag+".png").c_str());
    FeedbackStageExported(old_request,L"C:\\old-stage",true);
    Check(!g_feedback_session->stage_finished&&g_feedback_session->screenshots[0][0]==0,"previous session's late callbacks rejected by next session");
    RunWorker();
}
static void TestFailures() {
    Reset();reshade::api::effect_runtime r;pin_ok=false;
    wcscpy_s(g_feedback_last_zip,L"C:\\old-session\\feedback.zip");
    RequestFeedbackBundle();FeedbackPresent(&r);
    Check(g_feedback_status==5&&g_feedback_session==nullptr&&queue_calls==0&&g_feedback_last_zip[0]==0,"pin failure publishes no session, worker or previous ZIP path");
    Reset();queue_ok=false;wcscpy_s(g_feedback_last_zip,L"C:\\old-session\\feedback.zip");
    RequestFeedbackBundle();FeedbackPresent(&r);
    Check(g_feedback_status==5&&g_feedback_session==nullptr&&queued_worker==nullptr&&g_feedback_last_zip[0]==0,"queue failure clears shared session and previous path before delete");
    for(unsigned failure=0;failure<3;++failure) {
        Reset();config.enabled=false;RequestFeedbackBundle();FeedbackPresent(&r);
        tick=[&]{FeedbackPresent(&r);};
        if(failure==0)create_directory_ok=false;
        if(failure==1)nr_bundle::allocation_ok=false;
        if(failure==2)nr_bundle::run_ok=false;
        RunWorker();Check(g_feedback_status==5&&g_feedback_last_zip[0]==0,"directory/job/ZIP failure leaves no successful path");
    }
    Reset();stage_available=false;RequestFeedbackBundle();FeedbackPresent(&r);
    Check(g_feedback_session->stage_finished&&!g_feedback_session->stage_ok,"busy stage capture is not attached to new session");
    tick=[&]{FeedbackPresent(&r);};RunWorker();
    Check(Find("stages")&&Find("stages")->reason.find("already in progress")!=std::string::npos,"busy stage reason retained in bundle");
}
static void TestInitializationReentry() {
    Reset();reshade::api::effect_runtime r,other;config.enabled=false;
    during_pin=[&] {
        Check(g_feedback_status==1,"session reserved before metadata and module pin initialization");
        Check(!RequestFeedbackBundle(),"F8 during initialization rejected");
        FeedbackPresent(&other);
        Check(queue_calls==0&&g_feedback_session==nullptr,"second runtime cannot publish nested session during initialization");
    };
    RequestFeedbackBundle();FeedbackPresent(&r);
    Check(queue_calls==1&&pin_calls==1&&g_feedback_session->runtime_identity==&r,"initialization reentry creates only original worker");
    tick=[&]{FeedbackPresent(&r);};RunWorker();
}
static void TestLongTimeline() {
    Reset();reshade::api::effect_runtime r;RequestFeedbackBundle();FeedbackPresent(&r);
    const auto used=g_feedback_session->report_used;
    std::string huge(32700,'x');huge+="中文";
    FeedbackAppend(*g_feedback_session,"%s",huge.c_str());
    Check(g_feedback_session->report_used==used&&g_feedback_session->report[used]==0,
        "overflow append discarded as a whole without partial UTF8");
    Check(g_feedback_session->report_truncated,"rejected metadata append records truncation");
    fixture_bypass=std::string(512,'x');
    NgxParams params;FeatureRecord feature;
    for(unsigned i=0;i<130;++i) {
        fake_now+=100;FeedbackObserveEvaluate(&params,feature,i+1);
    }
    const auto omitted=g_feedback_session->timeline_omitted;
    Check(omitted>0&&g_feedback_session->observations+omitted==120,"timeline budget omits rows and preserves bounded observation work");
    Check(g_feedback_session->report_used<32768-7000,"optional timeline leaves room for mandatory final metadata");
    tick=[&]{FeedbackPresent(&r);FeedbackStageExported(g_stage_capture_request_id,L"C:\\long-timeline",true);};
    RunWorker();
    const auto &metadata=nr_bundle::last.metadata;
    Check(nr_bundle::runs==1&&g_feedback_status==3,"truncated optional timeline still packages required complete capture");
    Check(metadata.find("colorPolicy.status=")!=std::string::npos&&metadata.find("end.nrSuccess=")!=std::string::npos,
        "final policy and counters survive long timeline");
    Check(metadata.find("collection.metadataTruncated=1")!=std::string::npos&&
        metadata.find("collection.timelineRowsOmitted="+std::to_string(omitted))!=std::string::npos,
        "metadata tail records actual truncation and omitted-row count");
    Check(metadata.size()<32768&&MultiByteToWideChar(CP_UTF8,MB_ERR_INVALID_CHARS,metadata.c_str(),-1,nullptr,0)>0,
        "bounded final metadata remains valid UTF8");
}
static HANDLE stage_callback_entered=nullptr;
static std::atomic<bool> stage_callback_completed{false};
static DWORD WINAPI RaceStageExport(void *request) {
    SetEvent(stage_callback_entered);
    FeedbackStageExported(static_cast<unsigned long long>(reinterpret_cast<std::uintptr_t>(request)),L"C:\\racing-stage",true);
    stage_callback_completed=true;return 0;
}
static void TestStageRegistrationRace() {
    Reset();reshade::api::effect_runtime r;
    HANDLE thread=nullptr;
    stage_callback_completed=false;
    stage_callback_entered=CreateEventW(nullptr,TRUE,FALSE,nullptr);
    Check(stage_callback_entered!=nullptr,"stage callback synchronization event created");
    during_stage_request=[&] {
        const bool acquired=TryAcquireSRWLockExclusive(&g_feedback_lock)!=FALSE;
        if(acquired)ReleaseSRWLockExclusive(&g_feedback_lock);
        Check(!acquired,"request and request-id registration hold shared session lock continuously");
        thread=CreateThread(nullptr,0,&RaceStageExport,
            reinterpret_cast<void *>(static_cast<std::uintptr_t>(g_stage_capture_request_id.load())),0,nullptr);
        Check(thread!=nullptr,"independent stage export callback thread started");
        if(thread) {
            Check(WaitForSingleObject(stage_callback_entered,1000)==WAIT_OBJECT_0,"export worker entered while request function has not returned");
            Check(WaitForSingleObject(thread,20)==WAIT_TIMEOUT&&!stage_callback_completed,
                "early export callback waits for complete request-id publication");
        }
    };
    RequestFeedbackBundle();FeedbackPresent(&r);
    if(thread) {
        Check(WaitForSingleObject(thread,1000)==WAIT_OBJECT_0,"deferred callback completes after Present unlocks");
        CloseHandle(thread);
    }
    CloseHandle(stage_callback_entered);stage_callback_entered=nullptr;
    Check(stage_callback_completed&&g_feedback_session->stage_ok&&
        std::wstring(g_feedback_session->stage_directory)==L"C:\\racing-stage",
        "early completion is not lost and belongs to newly registered request");
    tick=[&]{FeedbackPresent(&r);};RunWorker();
    const auto *stage=Find("stages/original.pfm");
    Check(stage&&stage->source==L"C:\\racing-stage\\original.pfm","racing completion reaches bundle's exact directory");
}
static void TestDirectoryFallback() {
    Reset();wchar_t path[1024]={};
    Check(FeedbackCreateDirectory(path)&&std::wstring(path).rfind(L"C:\\fixture-documents\\DLSS5-Feedback\\",0)==0,
        "available Documents chosen for session directory");
    Check(documents_calls==1&&temp_calls==0,"available Documents does not touch Temp");
    for(auto failure:{DirectoryFailure::DocumentsLookup,DirectoryFailure::DocumentsRoot,DirectoryFailure::DocumentsSession}) {
        Reset();directory_failure=failure;
        Check(FeedbackCreateDirectory(path)&&std::wstring(path).rfind(L"C:\\fixture-temp\\",0)==0,
            "Documents lookup/root/session creation failure falls back to Temp");
        Check(temp_calls==1,"fallback performs bounded single Temp lookup");
    }
    Reset();documents_root_exists=true;
    Check(FeedbackCreateDirectory(path)&&temp_calls==0,"existing Documents root still allows unique new session");
    for(auto failure:{DirectoryFailure::BothRoots,DirectoryFailure::TempTooLong}) {
        Reset();directory_failure=failure;wcscpy_s(path,L"previous-path");
        Check(!FeedbackCreateDirectory(path)&&path[0]==0,"all-root failure or unusable Temp path leaves no stale directory");
    }
}
static void TestCanonicalScreenshotZip(const wchar_t *fixtures) {
    Reset();reshade::api::effect_runtime r;r.deliver=false;config.enabled=false;
    RequestFeedbackBundle();FeedbackPresent(&r);
    wchar_t capture_dir[1024]={},source[1024]={},target[1024]={},dot_path[1024]={},zip_dir[1024]={};
    swprintf_s(capture_dir,L"%ls\\captures",fixtures);
    swprintf_s(source,L"%ls\\normalization-source.png",fixtures);
    swprintf_s(zip_dir,L"%ls\\normalized-zip",fixtures);
    wchar_t tag[80]={};MultiByteToWideChar(CP_UTF8,MB_ERR_INVALID_CHARS,Tag(0).c_str(),-1,tag,80);
    swprintf_s(target,L"%ls\\截图 %ls.png",capture_dir,tag);
    swprintf_s(dot_path,L"%ls\\.\\截图 %ls.png",capture_dir,tag);
    Check(RealCreateDirectory(capture_dir)&&RealCreateDirectory(zip_dir),"real isolated path fixtures created");
    Check(CopyFileW(source,target,TRUE)!=FALSE,"real PNG fixture copied to callback target");
    char utf8[4096]={};WideToUtf8(dot_path,utf8,sizeof(utf8));
    OnFeedbackScreenshot(&r,utf8);
    Check(std::wstring(g_feedback_session->screenshots[0])==target,
        "actual callback canonicalizes dot component and retains Chinese filename");
    RunWorker();
    const auto *entry=Find("screenshots/current-0.png");
    Check(entry&&entry->source==target,"worker sends canonical callback path to allowlisted artifact");
    auto *job=actual_bundle::CreateJob(zip_dir,"regression=actual callback dot-component path to ZIP\n");
    Check(job!=nullptr,"actual ZIP job created for path integration");
    if(job) {
        Check(entry&&actual_bundle::AddFile(*job,entry->source.c_str(),"screenshots/current-0.png",actual_bundle::FileKind::Copy,true),
            "real packager accepts callback-derived source path");
        const auto result=actual_bundle::Run(*job);
        Check(result.status==actual_bundle::Status::Complete&&result.included_files==1&&result.required_complete,
            "canonical screenshot bytes actually published in complete ZIP");
        actual_bundle::DestroyJob(job);
    }
}
int wmain(int argc,wchar_t **argv) {
    if(argc!=2)return 2;
    InitializeCriticalSection(&g_chain_cs);
    TestCallbacks();TestReadyAndZeroNr(true,true);TestReadyAndZeroNr(false,true);
    TestReadyAndZeroNr(true,false);TestTimeoutAndNextSession();TestFailures();
    TestInitializationReentry();TestLongTimeline();TestStageRegistrationRace();
    TestDirectoryFallback();TestCanonicalScreenshotZip(argv[1]);
    DeleteCriticalSection(&g_chain_cs);
    std::printf("%u checks, %u failures\n",checks,failures);return failures?1:0;
}
