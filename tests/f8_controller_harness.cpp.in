using namespace nr_f8;
unsigned checks=0;
void Check(bool ok,const char *why){++checks;if(!ok){std::fprintf(stderr,"FAIL: %s\n",why);std::exit(1);}}
void Drain(){while(!queued.empty()){auto w=queued.front();queued.erase(queued.begin());if(w.fn!=Watchdog)w.fn(w.arg);}}
void Reset(){simulate_disk_poll=false;g_config_read_tick=0;Drain();Check(!g_session,"previous session is detached");g_status.store(Status::Idle);g_cancel=false;g_config_hold=false;stage_status=0;rr=false;g_shortfuse_nr_enabled=false;config_calls=0;nr_post_settings::capture_calls=0;nr_post_settings::current={true,100};nr_core_feedback::cancel_calls=0;nr_compat_present_runtime::capture_requests=0;config={};NormalizeConfig(config);g_config_generation=1;nr_processing_runtime::session={};nr_processing_runtime::effective=0;nr_processing_runtime::next_selection=1;nr_processing_runtime::Reconcile();test_clock+=100000;}
void Start(reshade::api::effect_runtime &r,Comparison kind=Comparison::Current){Check(RequestWithOptions({kind,false,0,0}),"request accepted");Present(&r);Check(g_session && g_status==Status::Running,"production Present starts session");}
void Shot(reshade::api::effect_runtime &r){
    std::wstring path=output_root+L"\\shot_"+std::wstring(r.tag.begin(),r.tag.end())+L".png";
    HANDLE f=CreateFileW(path.c_str(),GENERIC_WRITE,0,nullptr,CREATE_ALWAYS,FILE_ATTRIBUTE_NORMAL,nullptr);
    const unsigned char png[]={137,80,78,71,13,10,26,10,0,0,0,13,73,72,68,82,0,0,0,1,0,0,0,1,8,2,0,0,0,144,119,83,222,0,0,0,12,73,68,65,84,120,156,99,112,112,112,0,0,1,132,0,193,131,95,105,148,0,0,0,0,73,69,78,68,174,66,96,130};DWORD n;WriteFile(f,png,sizeof(png),&n,nullptr);CloseHandle(f);
    std::wstring dotted=output_root+L"\\.\\shot_"+std::wstring(r.tag.begin(),r.tag.end())+L".png";char utf8[4096]={};WideToUtf8(dotted.c_str(),utf8,sizeof(utf8));
    Screenshot(&r,utf8);Check(g_session->groups[g_session->group].shot_received,"canonical screenshot accepted");
    Check(std::wcsstr(g_session->groups[g_session->group].screenshot,L"\\.\\")==nullptr,"saved screenshot canonicalized");
    const std::wstring old=g_session->groups[g_session->group].screenshot;
    Screenshot(&r,(std::string(utf8)+".more").c_str());Check(old==g_session->groups[g_session->group].screenshot,"duplicate cannot replace");
}
NrStageCaptureInfo Info(unsigned long long frame,unsigned width,unsigned height){NrStageCaptureInfo n={};n.identity.frame_id=frame;n.identity.instance_id=7;n.identity.config_generation=g_config_generation;n.identity.since_reset=64;n.identity.warmed_up=true;n.identity.evaluation=frame;n.identity.tuning.intensity=config.intensity;n.identity.tuning.local_tone=config.local_tone;n.identity.tuning.local_structure=config.local_structure;n.identity.tuning.skin_structure=config.auto_mask?config.skin_structure:-1.f;n.identity.tuning.auto_mask=config.auto_mask;n.identity.tuning.ui_correction=config.ui_correction;n.identity.tuning.style=config.style;n.feature_generation=8;n.mode=config.mode;n.source_width=n.model_width=width;n.source_height=n.model_height=height;n.codec_flags=513;n.source_format=n.result_format=10;return n;}
void DeliverFrame(unsigned long long frame,unsigned width=3840,unsigned height=2160,bool map_fail=false){
    auto n=Info(frame,width,height);if(g_session)n.mode=g_session->groups[g_session->group].expected_mode;NrCaptureParams p={};p.game_jitter_valid=true;p.game_jitter_x=.25f;p.game_jitter_y=-.25f;p.reset_known=true;FrameTicket t={};
    Check(ReserveFrame(n,p,t),"production frame reservation");
    const UINT64 bytes=static_cast<UINT64>(n.width)*n.height*80+16;Check(nr_f8_budget::ReservePair(bytes),"readback budget reserved");
    auto *resource=new ID3D12Resource;resource->map_fail=map_fail;resource->values.resize(static_cast<size_t>(bytes/4),.25f);
    for(size_t i=resource->values.size()-4;i<resource->values.size();++i)resource->values[i]=1.f;
    nr_f8_budget::gpu_bytes.fetch_sub(bytes); // exact GPU handoff seam: default resource released
    RawReady(t,n,resource,bytes,true);Drain();
}
void FinishOff(reshade::api::effect_runtime &r){test_clock+=3100;Present(&r);Shot(r);Present(&r);Drain();}
void OriginalProcessing(bool fallback) {
    using Start=nr_processing::Start;
    config.mode=fallback?2:1;config.processing_start=fallback?Start::Before:Start::After;
    config.processing_selection=nr_processing_runtime::next_selection.fetch_add(1);
    nr_processing_runtime::Reconcile();
    if(fallback){nr_processing_runtime::carrier_serial=77;nr_processing_runtime::Reject(Start::Before,"original-before-fallback",true);}
    Check(nr_processing_runtime::Effective()==Start::After,"original saved After or sticky Before-to-After state prepared");
}
bool SameProcessing(nr_processing::Session a,nr_processing::Session b,unsigned long long selection) {
    using Start=nr_processing::Start;
    if(a.Requested()!=b.Requested()||a.Current()!=b.Current()||std::strcmp(a.Reason(),b.Reason()))return false;
    if(a.Select(a.Requested(),selection)||b.Select(b.Requested(),selection))return false;
    for(unsigned source=0;source<192;++source) {
        for(auto route:{Start::Before,Start::After,Start::Present})if(a.Ready(route,source)!=b.Ready(route,source))return false;
        if(a.Reject(a.Current(),source,"retry-probe",true)!=b.Reject(b.Current(),source,"retry-probe",true))return false;
    }
    return a.Ready(a.Current(),UINT64_MAX)==b.Ready(b.Current(),UINT64_MAX);
}
void TestFullscreen(){
    for(const auto kind:{Comparison::Current,Comparison::ShareMatrix})for(float skin:{0.f,2.f}) {
        Reset();config.enabled=true;config.mode=1;config.auto_mask=true;config.skin_structure=skin;
        OriginalProcessing(kind==Comparison::ShareMatrix&&skin==2.f);
        const auto original_processing=nr_processing_runtime::session;
        disk_config=config;simulate_disk_poll=true;const auto original=config;
        reshade::api::effect_runtime r;
        Check(RequestFullscreen(kind),"public full-screen request accepted");Present(&r);
        const unsigned groups=kind==Comparison::Current?1:7;
        for(unsigned i=0;i<groups;++i) {
            Check(g_session&&g_session->group==i,"full-screen group order");
            Check(g_session->options.full_screen&&g_session->groups[i].roi_target==0&&
                  !g_session->groups[i].overview_target,"full screen requires no center ROI or small overview");
            test_clock+=3100;
            const auto before=config;const auto generation=g_config_generation.load();
            Check(SameConfig(SnapshotConfig(),before)&&SameConfig(SnapshotOverlayConfig().config,before)&&
                  g_config_generation==generation,"overlay cannot reload disk during full-screen comparison");
            Check(config.skin_structure==skin&&config.auto_mask,"full-screen groups retain requested face setting");
            if(kind==Comparison::ShareMatrix&&i) {
                const auto expected_start=i<=3?nr_processing::Start::Before:nr_processing::Start::After;
                Check(config.processing_start==expected_start&&nr_processing_runtime::Effective()==expected_start,
                      "MATRIX_PROCESSING_START: every group actually selects its requested pre/post boundary");
                Check(config.processing_selection!=original.processing_selection,
                      "matrix groups have an explicit transient selection without overwriting the saved identity");
            }
            auto info=Info(100+i,3840,2160);NrCaptureParams params{};FrameTicket ticket{};
            Check(!ReserveFrame(info,params,ticket),"full-screen path cannot allocate raw ROI readback");
            Present(&r);
            const std::wstring path=output_root+L"\\full_"+std::wstring(r.tag.begin(),r.tag.end())+L".png";
            Check(CopyFileW((output_root+L"\\..\\native-display.png").c_str(),path.c_str(),TRUE)!=FALSE,"copy original full-resolution runtime fixture");
            char utf8[4096]{};WideToUtf8(path.c_str(),utf8,sizeof(utf8));Screenshot(&r,utf8);
            Check(g_session->groups[i].shot_received,"full-screen callback accepted");Present(&r);
        }
        Drain();Check(g_status==Status::Complete&&SameConfig(config,original)&&!g_config_hold,
                      "full-screen complete restores settings and releases hold");
        Check(SameProcessing(nr_processing_runtime::session,original_processing,original.processing_selection)&&
              nr_processing_runtime::Effective()==original_processing.Current(),
              "MATRIX_SESSION_RESTORE: completion restores original sticky route reason selection and retry behavior");
        Check(!nr_f8_budget::gpu_bytes&&!nr_f8_budget::cpu_bytes,"full-screen path has zero raw GPU and CPU allocation");
        const auto dest=output_root+L"\\fullscreen-"+std::to_wstring(groups)+L"-"+std::to_wstring(static_cast<int>(skin))+L".zip";
        Check(CopyFileW(g_last_zip,dest.c_str(),TRUE)!=FALSE,"publish full-screen archive fixture");
    }
}
void TestDefaultsAndPictures(){
    Reset();Check(Options{}.comparison==Comparison::Current,"default is current");config.enabled=false;reshade::api::effect_runtime r;
    Check(RequestWithOptions({}),"request accepted before Present");Cancel();
    Check(g_status==Status::Failed && g_cancel.load() && nr_core_feedback::cancel_calls==1 && !g_session,
        "pre-Present image cancellation retires its core request and reaches a terminal state");
    Cancel();Check(nr_core_feedback::cancel_calls==1,"repeated cancellation cannot cancel an unrelated core request");
    Check(RequestWithOptions({}),"request retry accepted after pre-Present cancellation");
    Present(&r);Check(g_session && g_status==Status::Running,"retry starts one image session");
    Cancel();Present(&r);Drain();Check(g_status==Status::Partial,"retry can be cancelled and packaged normally");
    Reset();config.enabled=false;Start(r);Check(config_calls==0,"current does not call ApplyConfig");
    Check(!RequestWithOptions({Comparison::ShareMatrix,false,0,0}),"second request rejected");
    test_clock+=3100;Present(&r);reshade::api::effect_runtime wrong;Screenshot(&wrong,"C:\\wrong_DLSS5_F8_1_0.png");Check(!g_session->groups[0].shot_received,"wrong runtime rejected");
    Screenshot(&r,"C:\\wrong_DLSS5_F8_1_00.png");Check(!g_session->groups[0].shot_received,"tag suffix rejected");
    Screenshot(&r,"C:\\wrong_DLSS5_F8_1_0.decoy.png");Check(!g_session->groups[0].shot_received,"tag before extra stem text rejected");
    Screenshot(&r,"C:\\wrong_DLSS5_F8_1_0.png.more");Check(!g_session->groups[0].shot_received,"tag before non-final extension rejected");
    Shot(r);Present(&r);Drain();
    Check(g_status==Status::Complete && config_calls==0 && !g_config_hold,"off current ZIP completed without config writes");
    Check(g_last_zip[0]!=0,"first ZIP path exists");Check(RequestWithOptions({}),"request after completion");Check(!g_last_zip[0],"new request clears previous ZIP");pin_fail=true;Present(&r);pin_fail=false;Check(g_status==Status::Failed && !g_last_zip[0],"PIN failure exposes no old ZIP");
}
void TestContinuous(unsigned width,unsigned height){
    Reset();config.enabled=true;config.mode=1;reshade::api::effect_runtime r;Start(r);test_clock+=3100;
    for(unsigned i=0;i<kCurrentRoiFrames;++i)DeliverFrame(100+i,width,height);
    DeliverFrame(999,width,height);Check(g_session->groups[0].frames[16].info.stride>1,"overview separate sampled grid");
    Present(&r);Shot(r);Present(&r);Drain();
    Check(g_status==Status::Complete && config_calls==0,"complete three-frame 512 ROI plus overview ZIP");
    Check(!nr_f8_budget::gpu_bytes && !nr_f8_budget::cpu_bytes,"budget drained after worker");
    std::printf("ZIP %u x %u: ",width,height);char z[4096];WideToUtf8(g_last_zip,z,sizeof(z));std::puts(z);
    if(width==3840 && height==2160){std::wstring dest=output_root+L"\\feedback.zip";Check(CopyFileW(g_last_zip,dest.c_str(),TRUE)!=FALSE,"publish parser fixture");}
}
void CompleteMatrixGroup(reshade::api::effect_runtime &r,unsigned expected_group,bool pixels=true){
    Check(g_session&&g_session->group==expected_group,"expected matrix group active");
    test_clock+=3100;
    if(simulate_disk_poll) {
        const auto expected=config; const auto generation=g_config_generation.load();
        const auto plain=SnapshotConfig(); const auto overlay=SnapshotOverlayConfig();
        Check(SameConfig(plain,expected)&&SameConfig(overlay.config,expected)&&g_config_generation==generation,
              "open overlay and ordinary snapshots preserve the transient capture generation after 500 ms");
    }

    if(pixels){DeliverFrame(1000+expected_group*10,64,64);DeliverFrame(1001+expected_group*10,64,64);}
    Present(&r);Shot(r);Present(&r);
}
void TestShareMatrix(){
    Reset();config.enabled=true;config.mode=1;config.transfer_strength=config.post_transfer_strength=.7f;
    config.light_control_mode=1;
    disk_config=config;simulate_disk_poll=true;
    const auto original=config;reshade::api::effect_runtime r;Start(r,Comparison::ShareMatrix);
    disk_config.light_control_mode=0; // A later INI poll must not change a held capture scope.
    Check(g_session->group_count==7&&g_session->groups[0].roi_target==2,"share matrix owns seven bounded two-ROI groups");
    Check(g_session->groups[0].requested.light_control_mode==1&&g_session->groups[0].actual.light_control_mode==1,
          "original capture group also preserves the frozen light control mode");
    CompleteMatrixGroup(r,0,false);
    for(unsigned group=1;group<7;++group){
        const auto &g=g_session->groups[group];
        Check(g.requested.enabled&&g.requested.mode==(group<=3?2:1),"matrix route order");
        const unsigned expected=group==1||group==4?50u:group==2||group==5?75u:100u;
        const unsigned expected_post=group<=3?100u:expected;
        Check(g.requested_post_percent==expected_post&&g.actual_post_percent==expected_post,"matrix post percentage applied only to post route");
        Check(std::fabs(ActiveTransferStrength(g.requested)-.7f)<.001f,"matrix preserves the user's effect strength");
        Check(g.requested.light_control_mode==1&&g.actual.light_control_mode==1&&config.light_control_mode==1,
              "all seven capture groups preserve the frozen light control mode");
        if(group<=3)Check(g.requested.work_mode==5&&std::fabs(g.requested.custom_work_scale-expected/100.f)<.001f,
            "pre-SR matrix changes only its working resolution tier");
        CompleteMatrixGroup(r,group);
    }
    Drain();
    Check(g_status==Status::Complete&&SameConfig(config,original)&&nr_post_settings::current.percent==100,
        "complete matrix restores chain and post settings");
    disk_config.skin_structure=1.5f;test_clock+=600;
    Check(SnapshotOverlayConfig().config.skin_structure==1.5f,
          "disk polling resumes after capture releases its hold");
    Check(config.light_control_mode==0,"a later disk mode request is read only after the capture releases its hold");
    simulate_disk_poll=false;


    Reset();config.enabled=true;config.mode=1;const auto rr_original=config;rr=true;Start(r,Comparison::ShareMatrix);
    CompleteMatrixGroup(r,0,false);
    for(unsigned group=1;group<=3;++group){
        Check(g_session->groups[group].partial&&g_session->groups[group].sealed&&
              std::strstr(g_session->groups[group].reason,"Ray Reconstruction"),
              "RR skips every pre-SR group before changing settings");
        auto baseline=GroupConfig(rr_original,Comparison::ShareMatrix,0);baseline.processing_selection=config.processing_selection;
        Check(SameConfig(config,baseline),"RR pre-SR skip retains native baseline with its existing transient selection");
        CompleteMatrixGroup(r,group,false);
    }
    for(unsigned group=4;group<7;++group)CompleteMatrixGroup(r,group);
    Drain();
    Check(g_status==Status::Partial&&SameConfig(config,rr_original)&&nr_post_settings::current.percent==100,
        "RR matrix keeps native/post groups, records skips and restores settings");
}
void TestCurrentRrRoute(){
    Reset();config.enabled=true;config.mode=2;const auto original=config;rr=true;reshade::api::effect_runtime r;Start(r);
    Check(g_session->groups[0].expected_mode==1&&g_session->groups[0].rr_at_start&&config_calls==0,
        "current RR capture expects post mode without changing saved Mode2");
    test_clock+=3100;for(unsigned i=0;i<kCurrentRoiFrames;++i)DeliverFrame(200+i,64,64);DeliverFrame(900,64,64);
    Check(g_session->groups[0].frames[0].info.mode==1,"RR current capture records actual post mode");
    Present(&r);Shot(r);Present(&r);Drain();
    Check(g_status==Status::Complete&&SameConfig(config,original),"current RR capture completes and preserves the user's mode");

    Reset();config.enabled=true;config.mode=2;Start(r);test_clock+=3100;DeliverFrame(300,64,64);rr=true;
    Present(&r);Shot(r);Present(&r);Drain();
    Check(g_status==Status::Partial&&SameConfig(config,original),"mid-capture RR route change is partial and restores settings");
}
void TestPartialAndRestore(){
    for(bool fallback:{false,true})for(unsigned ending=0;ending<4;++ending) {
        Reset();config.enabled=true;OriginalProcessing(fallback);
        const auto original_config=config;const auto original_processing=nr_processing_runtime::session;
        reshade::api::effect_runtime runtime;Start(runtime,Comparison::ShareMatrix);
        AcquireSRWLockExclusive(&g_control);
        AcquireSRWLockExclusive(&g_lock);g_session->group=1;ReleaseSRWLockExclusive(&g_lock);StartGroup(*g_session);
        Check(nr_processing_runtime::Effective()==nr_processing::Start::Before,"matrix explicitly retries pre despite original After fallback");
        AcquireSRWLockExclusive(&g_lock);g_session->group=4;ReleaseSRWLockExclusive(&g_lock);StartGroup(*g_session);
        Check(nr_processing_runtime::Effective()==nr_processing::Start::After,"matrix then explicitly selects post");
        ReleaseSRWLockExclusive(&g_control);
        if(ending==0){Cancel();Present(&runtime);}
        if(ending==1){test_clock+=30001;AcquireSRWLockExclusive(&g_control);Tick(nullptr);ReleaseSRWLockExclusive(&g_control);}
        if(ending==2){Cancel();queue_fail=true;Present(&runtime);}
        if(ending==3)RuntimeDestroyed(&runtime);
        Drain();
        Check(SameConfig(config,original_config)&&!g_config_hold&&!g_session&&
              SameProcessing(nr_processing_runtime::session,original_processing,original_config.processing_selection)&&
              nr_processing_runtime::Effective()==original_processing.Current(),
              "MATRIX_SESSION_RESTORE: cancellation timeout packaging failure and runtime destruction restore full session");
    }
    Reset();config.enabled=true;config.mode=1;config.transfer_strength=config.post_transfer_strength=.7f;const auto original=config;reshade::api::effect_runtime r;Start(r,Comparison::ShareMatrix);
    Check(config_calls==1 && !config.enabled,"explicit comparison switches chain");Cancel();Present(&r);Drain();Check(SameConfig(config,original) && config_calls==2 && !g_config_hold && g_status==Status::Partial,"cancel restores exact settings and creates partial ZIP");
    Reset();config.enabled=true;Start(r);test_clock+=3100;DeliverFrame(100);auto gap=Info(102,3840,2160);FrameTicket t;Check(!ReserveFrame(gap,{},t) && g_session->groups[0].partial,"gap seals partial sequence");
    Present(&r);Shot(r);Present(&r);Drain();Check(g_status==Status::Partial,"gap retained in partial ZIP");
    Reset();config.enabled=true;Start(r);test_clock+=3100;DeliverFrame(100,3840,2160,true);Present(&r);Shot(r);Present(&r);Drain();Check(g_status==Status::Partial,"map failure partial");
    Reset();config.enabled=true;Start(r);rr=true;test_clock+=3100;Present(&r);Shot(r);Present(&r);Drain();Check(g_status==Status::Partial,"RR still collects screenshot and logs");
    Reset();config.enabled=true;Start(r,Comparison::ShareMatrix);test_clock+=30001;AcquireSRWLockExclusive(&g_control);Tick(nullptr);ReleaseSRWLockExclusive(&g_control);Drain();Check(g_status==Status::Partial && !g_config_hold,"watchdog timeout restores without Present");
}
void TestFailuresAndLateDelivery(){
    reshade::api::effect_runtime runtime;
    Reset();config.enabled=true;config.transfer_strength=config.post_transfer_strength=0;Start(runtime);test_clock+=3100;Present(&runtime);Shot(runtime);
    Check(g_session->groups[0].shot_received && g_session->groups[0].count==0,"enabled zero-strength still gets display evidence");test_clock+=30001;Present(&runtime);Drain();Check(g_status==Status::Partial,"zero NR records retain screenshot in partial ZIP");
    Reset();config.enabled=true;const auto original=config;Check(RequestWithOptions({Comparison::ShareMatrix,false,0,0}),"queue-failure request");queue_fail=true;Present(&runtime);Drain();
    Check(g_status==Status::Partial && SameConfig(config,original) && !g_config_hold,"watchdog queue failure restores comparison and packages partial");
    Reset();config.enabled=true;Start(runtime,Comparison::ShareMatrix);Cancel();queue_fail=true;Present(&runtime);Drain();Check(g_status==Status::Failed && !g_config_hold && !g_last_zip[0],"packager queue failure releases configuration hold with no stale ZIP");
    Reset();config.enabled=true;Start(runtime);test_clock+=3100;auto info=Info(100,256,256);FrameTicket old;
    Check(ReserveFrame(info,{},old),"reserve outstanding readback");const UINT64 bytes=256ull*256*80+16;
    auto *resource=new ID3D12Resource;resource->values.resize(bytes/4,.25f);Check(nr_f8_budget::ReservePair(bytes),"queued readback budget");nr_f8_budget::gpu_bytes.fetch_sub(bytes);
    RawReady(old,info,resource,bytes,true);Cancel();Present(&runtime);Drain();Check(!nr_f8_budget::cpu_bytes,"readback arriving after detach releases budget");
    Reset();config.enabled=true;Start(runtime);resource=new ID3D12Resource;resource->values.resize(bytes/4,.25f);Check(nr_f8_budget::ReservePair(bytes),"stale readback budget");nr_f8_budget::gpu_bytes.fetch_sub(bytes);RawReady(old,info,resource,bytes,true);
    Check(g_session->groups[0].count==0 && !nr_f8_budget::cpu_bytes,"previous session completion cannot attach to a new session");Cancel();Present(&runtime);Drain();
    for(unsigned change=0;change<5;++change){
        Reset();config.enabled=true;Start(runtime);test_clock+=3100;info=Info(100,256,256);FrameTicket ticket;Check(ReserveFrame(info,{},ticket),"identity first frame");
        auto next=Info(101,256,256);NrCaptureParams params;
        if(change==0)++next.feature_generation;else if(change==1)++next.source_width;else if(change==2)++next.source_format;else if(change==3)next.codec_flags^=16;else params.reset=true;
        Check(!ReserveFrame(next,params,ticket) && g_session->groups[0].partial,"changed contract cannot continue existing sequence");Cancel();Present(&runtime);Drain();
    }
    Reset();config.enabled=true;Start(runtime);test_clock+=3100;info=Info(100,256,256);FrameTicket t;Check(ReserveFrame(info,{},t),"statistics first frame");info=Info(101,256,256);info.codec_flags|=8;
    Check(ReserveFrame(info,{},t),"statistics-only codec bit may vary without changing color contract");Cancel();Present(&runtime);Drain();
}
void TestBudgetAndLegacyFailure(){
    using namespace nr_f8_budget;Check(ReservePair(80ull*1024*1024),"budget first allocation");Check(!ReservePair(80ull*1024*1024),"budget denies second concurrent allocation");ReleasePair(80ull*1024*1024);Check(!gpu_bytes && !cpu_bytes,"failed reservation rolls back");
    wchar_t directory[1024]={};Check(FeedbackCreateDirectory(directory),"oversize fixture directory");std::wstring path=std::wstring(directory)+L"\\old-sequence.bin";
    HANDLE f=CreateFileW(path.c_str(),GENERIC_WRITE,0,nullptr,CREATE_NEW,FILE_ATTRIBUTE_NORMAL,nullptr);LARGE_INTEGER size;size.QuadPart=80ll*1024*1024;SetFilePointerEx(f,size,nullptr,FILE_BEGIN);SetEndOfFile(f);CloseHandle(f);
    auto *job=nr_bundle::CreateJob(directory,"fixture=old-monolithic\n");Check(nr_bundle::AddFile(*job,path.c_str(),"sequence.bin",nr_bundle::FileKind::Copy,true,112ull*1024*1024),"legacy AddFile accepted reservation");auto result=nr_bundle::Run(*job);Check(!result.required_complete,"actual ZIP proves old80MiB sequence rejected despite112MiB argument");nr_bundle::DestroyJob(job);DeleteFileW(path.c_str());
}
int main(int argc,char **argv){Check(argc==2,"output argument");wchar_t wide[1024]={};MultiByteToWideChar(CP_UTF8,0,argv[1],-1,wide,1024);output_root=wide;output_root+=L"\\run-"+std::to_wstring(GetCurrentProcessId());Check(CreateDirectoryW(output_root.c_str(),nullptr)!=FALSE,"unique fixture directory");
    const std::wstring log=output_root+L"\\fixture.log";wcscpy_s(g_log_path,log.c_str());wcscpy_s(g_ini_path,log.c_str());wcscpy_s(g_reshade_ini_path,log.c_str());FILE *f=nullptr;_wfopen_s(&f,log.c_str(),L"wb");std::fputs("fixture-only=true\n",f);std::fclose(f);
    wcscpy_s(nr_core_feedback::g_report_path,g_log_path);wcscpy_s(g_feedback_last_zip,g_log_path);
    {
        using namespace nr_f8;
        Reset();config.enabled=true;g_config_hold.store(true);
        Check(!RequestWithOptions(Options{}),"external replay lease rejects an overlapping image request");
        Check(g_config_hold.load()&&!config_calls,"rejected request does not release another diagnostic lease");
        g_config_hold.store(false);
        Reset();config.enabled=true;
        Check(RequestWithOptions(Options{}),"image request can wait for its core report");
        g_config_hold.store(true);reshade::api::effect_runtime pending_runtime;
        Present(&pending_runtime);
        Check(g_status==Status::Failed&&!g_session&&!config_calls&&g_config_hold.load(),
            "late lease conflict rejects publication without altering the other owner");
        g_config_hold.store(false);
    }
    TestFullscreen();
    Reset();config.processing_start=nr_processing::Start::Present;nr_processing_runtime::Reconcile();
    const auto present_original=config;
    Check(RequestWithOptions({Comparison::ShareMatrix,false,0,0}),"Present capture request uses its own capture path");
    Check(nr_compat_present_runtime::capture_requests==1&&!g_session&&!g_config_hold&&config_calls==0&&SameConfig(config,present_original),
          "Present request never starts or relabels the native stage matrix");
    Reset();
    TestFaceDiagnostic();
    TestDefaultsAndPictures();TestContinuous(3840,2160);TestContinuous(3840,2400);TestShareMatrix();TestCurrentRrRoute();TestPartialAndRestore();TestFailuresAndLateDelivery();TestBudgetAndLegacyFailure();
    std::printf("PASS production F8 controller/stream/ZIP: %u checks\n",checks);return 0;
}
