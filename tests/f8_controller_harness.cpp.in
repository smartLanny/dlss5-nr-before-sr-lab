struct ID3D12Resource { std::vector<float> values; bool map_fail=false; };
struct D3D12_RANGE { SIZE_T Begin,End; };
HRESULT ID3D12Resource_Map(ID3D12Resource *p,UINT,const D3D12_RANGE *,void **out){*out=p->values.data();return p->map_fail?E_FAIL:S_OK;}
void ID3D12Resource_Unmap(ID3D12Resource *,UINT,const D3D12_RANGE *){}
void ReleaseCom(ID3D12Resource *&p){delete p;p=nullptr;}
struct FeedbackSession {char report[32768]={};std::size_t used=0;};
void FeedbackAppend(FeedbackSession &s,const char *format,...){va_list a;va_start(a,format);const int n=std::vsnprintf(s.report+s.used,sizeof(s.report)-s.used,format,a);va_end(a);if(n>0 && static_cast<size_t>(n)<sizeof(s.report)-s.used)s.used+=n;}
void FeedbackAppendActivity(FeedbackSession &s,const char *p){FeedbackAppend(s,"%s.mockRuntime=1\n",p);}
std::atomic<unsigned> g_config_generation{1};std::atomic<bool> g_shortfuse_nr_enabled{false};
ChainConfig config={};unsigned config_calls=0,stage_status=0,dir_count=0;bool rr=false,pin_fail=false,queue_fail=false;
ULONGLONG test_clock=100000;
std::wstring output_root;wchar_t g_log_path[1024]={},g_ini_path[1024]={},g_reshade_ini_path[1024]={};
const char *kBuildIdentity="beta0.4.1-controller-fixture";
constexpr const char *kSourceCommit="fixture";constexpr bool kSourceDirty=true;
struct ModuleIdentity { const char *sha256="fixture-unavailable", *status="fixture"; };
const ModuleIdentity &EnsureRuntimeIdentityOnWorker(){static ModuleIdentity value;return value;}
unsigned StageCaptureStatus(){return stage_status;}
bool ShouldGuardFeature1ForRayReconstruction(){return rr;}
bool ApplyConfig(ChainConfig c,const char *,bool persist){if(persist)std::abort();++config_calls;if(SameConfig(c,config))return false;config=c;++g_config_generation;return true;}
ChainConfig SnapshotConfig(){return config;}
bool FeedbackCreateDirectory(wchar_t (&p)[1024]){swprintf_s(p,L"%ls\\session-%u",output_root.c_str(),++dir_count);return CreateDirectoryW(p,nullptr)!=FALSE;}
void FeedbackAddLogBeside(nr_bundle::Job &j,const wchar_t *,const wchar_t *,const char *name,bool required){nr_bundle::AddFile(j,g_log_path,name,nr_bundle::FileKind::LogTail,required);}
void FeedbackAddModules(nr_bundle::Job &,FeedbackSession &s){FeedbackAppend(s,"fixture.modules=unavailable\n");}
void WideToUtf8(const wchar_t *w,char *p,size_t n){WideCharToMultiByte(CP_UTF8,0,w,-1,p,static_cast<int>(n),nullptr,nullptr);}
struct Work{DWORD (WINAPI *fn)(void *);void *arg;};std::vector<Work> queued;
BOOL TestQueue(DWORD (WINAPI *fn)(void *),void *arg,ULONG){if(queue_fail){queue_fail=false;return FALSE;}queued.push_back({fn,arg});return TRUE;}
BOOL TestPin(DWORD,LPCWSTR,HMODULE *p){*p=GetModuleHandleW(nullptr);return !pin_fail;}
#define GetTickCount64() test_clock
#define QueueUserWorkItem TestQueue
#define GetModuleHandleExW TestPin
