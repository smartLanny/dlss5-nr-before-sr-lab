struct Harness {
    ID3D12Device* device=nullptr;ID3D12CommandQueue* queue=nullptr;ID3D12CommandAllocator* allocator=nullptr;
    ID3D12GraphicsCommandList* list=nullptr;ID3D12Fence* fence=nullptr;HANDLE event=nullptr;UINT64 value=0;
    Harness(){IDXGIFactory4* factory=nullptr;IDXGIAdapter* adapter=nullptr;
        Hr(CreateDXGIFactory2(0,IID_IDXGIFactory4,reinterpret_cast<void**>(&factory)),"factory");
        Hr(IDXGIFactory4_EnumWarpAdapter(factory,IID_IDXGIAdapter,reinterpret_cast<void**>(&adapter)),"WARP");
        Hr(D3D12CreateDevice(reinterpret_cast<IUnknown*>(adapter),D3D_FEATURE_LEVEL_11_0,IID_ID3D12Device,reinterpret_cast<void**>(&device)),"device");
        ReleaseCom(adapter);ReleaseCom(factory);D3D12_COMMAND_QUEUE_DESC desc{};
        Hr(ID3D12Device_CreateCommandQueue(device,&desc,IID_ID3D12CommandQueue,reinterpret_cast<void**>(&queue)),"queue");
        Hr(ID3D12Device_CreateCommandAllocator(device,D3D12_COMMAND_LIST_TYPE_DIRECT,IID_ID3D12CommandAllocator,reinterpret_cast<void**>(&allocator)),"allocator");
        Hr(ID3D12Device_CreateCommandList(device,0,D3D12_COMMAND_LIST_TYPE_DIRECT,allocator,nullptr,IID_ID3D12GraphicsCommandList,reinterpret_cast<void**>(&list)),"list");
        Hr(ID3D12Device_CreateFence(device,0,D3D12_FENCE_FLAG_NONE,IID_ID3D12Fence,reinterpret_cast<void**>(&fence)),"fence");
        event=CreateEventW(nullptr,FALSE,FALSE,nullptr);Check(event!=nullptr,"event");
    }
    void Submit(bool producer){Hr(ID3D12GraphicsCommandList_Close(list),"close");ID3D12CommandList* commands[]={reinterpret_cast<ID3D12CommandList*>(list)};
        ID3D12CommandQueue_ExecuteCommandLists(queue,1,commands);
        if(producer){transport::Lock lock;transport::GuideCopiesSubmitted(queue,transport::RecordingOf(list),true);}
        Hr(ID3D12CommandQueue_Signal(queue,fence,++value),"signal");
    }
    void Wait(){Hr(ID3D12Fence_SetEventOnCompletion(fence,value,event),"completion event");Check(WaitForSingleObject(event,10000)==WAIT_OBJECT_0,"bounded completion");Check(ID3D12Fence_GetCompletedValue(fence)>=value,"completed fence");}
    void Reset(){Hr(ID3D12CommandAllocator_Reset(allocator),"allocator reset");Hr(ID3D12GraphicsCommandList_Reset(list,allocator,nullptr),"list reset");++transport::recording_reset;}
    ~Harness(){if(event)CloseHandle(event);ReleaseCom(fence);ReleaseCom(list);ReleaseCom(allocator);ReleaseCom(queue);ReleaseCom(device);}
};
struct Consumer {
    ID3D12Device* device=nullptr;ID3D12CommandQueue* queue=nullptr;ID3D12CommandAllocator* allocator=nullptr;
    ID3D12GraphicsCommandList* list=nullptr;ID3D12Fence* fence=nullptr;HANDLE event=nullptr;UINT64 value=0;
    Consumer(ID3D12Device* d,ID3D12CommandQueue* q):device(d),queue(q){ID3D12Device_AddRef(device);ID3D12CommandQueue_AddRef(queue);
        Hr(ID3D12Device_CreateCommandAllocator(device,D3D12_COMMAND_LIST_TYPE_DIRECT,IID_ID3D12CommandAllocator,reinterpret_cast<void**>(&allocator)),"consumer allocator");
        Hr(ID3D12Device_CreateCommandList(device,0,D3D12_COMMAND_LIST_TYPE_DIRECT,allocator,nullptr,IID_ID3D12GraphicsCommandList,reinterpret_cast<void**>(&list)),"consumer list");
        Hr(ID3D12Device_CreateFence(device,0,D3D12_FENCE_FLAG_NONE,IID_ID3D12Fence,reinterpret_cast<void**>(&fence)),"consumer fence");
        event=CreateEventW(nullptr,FALSE,FALSE,nullptr);Check(event!=nullptr,"consumer event");}
    void Submit(){Hr(ID3D12GraphicsCommandList_Close(list),"consumer close");ID3D12CommandList* lists[]={reinterpret_cast<ID3D12CommandList*>(list)};
        ID3D12CommandQueue_ExecuteCommandLists(queue,1,lists);Hr(ID3D12CommandQueue_Signal(queue,fence,++value),"consumer signal");}
    void Wait(){Hr(ID3D12Fence_SetEventOnCompletion(fence,value,event),"consumer completion event");
        Check(WaitForSingleObject(event,10000)==WAIT_OBJECT_0,"bounded consumer completion");}
    ~Consumer(){if(event)CloseHandle(event);ReleaseCom(fence);ReleaseCom(list);ReleaseCom(allocator);ReleaseCom(queue);ReleaseCom(device);}
};
ID3D12Resource* Buffer(ID3D12Device* device,UINT64 size,D3D12_HEAP_TYPE type){
    D3D12_HEAP_PROPERTIES heap{};heap.Type=type;heap.CreationNodeMask=heap.VisibleNodeMask=1;
    D3D12_RESOURCE_DESC desc{};desc.Dimension=D3D12_RESOURCE_DIMENSION_BUFFER;desc.Width=size;desc.Height=1;
    desc.DepthOrArraySize=desc.MipLevels=desc.SampleDesc.Count=1;desc.Layout=D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
    ID3D12Resource* resource=nullptr;Hr(ID3D12Device_CreateCommittedResource(device,&heap,D3D12_HEAP_FLAG_NONE,&desc,
        type==D3D12_HEAP_TYPE_UPLOAD?D3D12_RESOURCE_STATE_GENERIC_READ:D3D12_RESOURCE_STATE_COPY_DEST,nullptr,IID_ID3D12Resource,reinterpret_cast<void**>(&resource)),"buffer");return resource;
}
ID3D12Resource* Input(Harness& h,DXGI_FORMAT format,unsigned components,ID3D12Resource*& upload,
    D3D12_RESOURCE_FLAGS flags=D3D12_RESOURCE_FLAG_NONE){
    D3D12_HEAP_PROPERTIES heap{};heap.Type=D3D12_HEAP_TYPE_DEFAULT;heap.CreationNodeMask=heap.VisibleNodeMask=1;
    D3D12_RESOURCE_DESC desc{};desc.Dimension=D3D12_RESOURCE_DIMENSION_TEXTURE2D;desc.Width=desc.Height=8;
    desc.DepthOrArraySize=desc.MipLevels=desc.SampleDesc.Count=1;desc.Format=format;desc.Flags=flags;ID3D12Resource* resource=nullptr;
    Hr(ID3D12Device_CreateCommittedResource(h.device,&heap,D3D12_HEAP_FLAG_NONE,&desc,D3D12_RESOURCE_STATE_COPY_DEST,nullptr,IID_ID3D12Resource,reinterpret_cast<void**>(&resource)),"input texture");
    D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint{};UINT64 size=0;ID3D12Device_GetCopyableFootprints(h.device,&desc,0,1,0,&footprint,nullptr,nullptr,&size);
    upload=Buffer(h.device,size,D3D12_HEAP_TYPE_UPLOAD);unsigned char* mapped=nullptr;D3D12_RANGE none{};
    Hr(ID3D12Resource_Map(upload,0,&none,reinterpret_cast<void**>(&mapped)),"upload map");std::memset(mapped,0,size);
    for(unsigned y=0;y<8;++y)for(unsigned x=0;x<8;++x)for(unsigned c=0;c<components;++c){const float value=float(y*100+x*10+c)+0.25f;
        std::memcpy(mapped+footprint.Offset+y*footprint.Footprint.RowPitch+(x*components+c)*4,&value,4);}
    ID3D12Resource_Unmap(upload,0,nullptr);D3D12_TEXTURE_COPY_LOCATION from{},to{};
    from.pResource=upload;from.Type=D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;from.PlacedFootprint=footprint;
    to.pResource=resource;to.Type=D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;ID3D12GraphicsCommandList_CopyTextureRegion(h.list,&to,0,0,0,&from,nullptr);
    auto state=D3D12_RESOURCE_STATE_COPY_DEST;Transition(h.list,resource,state,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);return resource;
}
ID3D12Resource* ViewShape(Harness& h,unsigned mips,unsigned layers,unsigned samples){
    D3D12_HEAP_PROPERTIES heap{};heap.Type=D3D12_HEAP_TYPE_DEFAULT;heap.CreationNodeMask=heap.VisibleNodeMask=1;
    D3D12_RESOURCE_DESC desc{};desc.Dimension=D3D12_RESOURCE_DIMENSION_TEXTURE2D;desc.Width=desc.Height=16;
    desc.DepthOrArraySize=static_cast<UINT16>(layers);desc.MipLevels=static_cast<UINT16>(mips);desc.SampleDesc.Count=samples;
    desc.Format=DXGI_FORMAT_R8G8B8A8_UNORM;desc.Flags=D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;ID3D12Resource* resource=nullptr;
    Hr(ID3D12Device_CreateCommittedResource(h.device,&heap,D3D12_HEAP_FLAG_NONE,&desc,D3D12_RESOURCE_STATE_RENDER_TARGET,
        nullptr,IID_ID3D12Resource,reinterpret_cast<void**>(&resource)),"view shape texture");return resource;
}
void CheckViewClear(Harness& h,ID3D12Resource* native,reshade::api::resource_view_desc desc,bool whole){
    using namespace transport;reshade::api::device owner;reshade::api::resource_view view{5566};
    OnSourceInitView(&owner,{reinterpret_cast<Id>(native)},reshade::api::resource_usage::render_target,desc,view);
    const auto resource=ResourceOf(native);const auto recording=RecordingOf(h.list);
    auto* observed=FindSourceRtv(view.handle,resource.device);
    Check(observed&&observed->whole==whole,"default RTV whole proof requires the actual single-surface shape");
    Label prior{};prior.source={41,1,1};prior.role=Role::Generated;prior.fg_consumed=true;
    lineage.Presented(resource,prior,QueueOf(h.queue));
    OnClearRtv(h.list,{view.handle},true);const auto label=lineage.Lookup(resource,recording);
    Check(whole?!label.tainted&&label.role==Role::Unknown&&!label.processed&&!label.fg_consumed:label.tainted,
        "only proven whole RTV clear replaces processed/generated provenance");
    lineage.Reset(recording);lineage.Forget(resource);OnSourceDestroyView(&owner,view);
}
struct Readback{ID3D12Resource* buffer=nullptr;D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint{};UINT64 size=0;};
Readback Read(ID3D12Device* device,ID3D12GraphicsCommandList* list,ID3D12Resource* resource){Readback r;const auto desc=ID3D12Resource_GetDesc(resource);
    ID3D12Device_GetCopyableFootprints(device,&desc,0,1,0,&r.footprint,nullptr,nullptr,&r.size);r.buffer=Buffer(device,r.size,D3D12_HEAP_TYPE_READBACK);
    auto state=D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;Transition(list,resource,state,D3D12_RESOURCE_STATE_COPY_SOURCE);
    D3D12_TEXTURE_COPY_LOCATION from{},to{};from.pResource=resource;from.Type=D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
    to.pResource=r.buffer;to.Type=D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;to.PlacedFootprint=r.footprint;
    ID3D12GraphicsCommandList_CopyTextureRegion(list,&to,0,0,0,&from,nullptr);Transition(list,resource,state,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);return r;
}
void Verify(Readback& r,unsigned x0,unsigned y0,unsigned components){unsigned char* mapped=nullptr;D3D12_RANGE range{0,static_cast<SIZE_T>(r.size)};
    Hr(ID3D12Resource_Map(r.buffer,0,&range,reinterpret_cast<void**>(&mapped)),"readback map");
    for(unsigned y=0;y<3;++y)for(unsigned x=0;x<4;++x)for(unsigned c=0;c<components;++c){float value=0;
        std::memcpy(&value,mapped+r.footprint.Offset+y*r.footprint.Footprint.RowPitch+(x*components+c)*4,4);
        Check(value==float((y+y0)*100+(x+x0)*10+c)+0.25f,"owned crop preserves exact guide bytes");}
    D3D12_RANGE none{};ID3D12Resource_Unmap(r.buffer,0,&none);ReleaseCom(r.buffer);
}
struct RawReadback{
    ID3D12Resource* buffer=nullptr;D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint{};
    UINT rows=0;UINT64 row_bytes=0,size=0;
};
RawReadback ReadRaw(ID3D12Device* device,ID3D12GraphicsCommandList* list,ID3D12Resource* resource,D3D12_RESOURCE_STATES before){
    RawReadback r;const auto desc=ID3D12Resource_GetDesc(resource);
    ID3D12Device_GetCopyableFootprints(device,&desc,0,1,0,&r.footprint,&r.rows,&r.row_bytes,&r.size);
    r.buffer=Buffer(device,r.size,D3D12_HEAP_TYPE_READBACK);
    auto state=before;Transition(list,resource,state,D3D12_RESOURCE_STATE_COPY_SOURCE);
    D3D12_TEXTURE_COPY_LOCATION from{},to{};from.pResource=resource;from.Type=D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
    to.pResource=r.buffer;to.Type=D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;to.PlacedFootprint=r.footprint;
    ID3D12GraphicsCommandList_CopyTextureRegion(list,&to,0,0,0,&from,nullptr);
    Transition(list,resource,state,before);return r;
}
std::vector<unsigned char> Compact(RawReadback& r){
    unsigned char* mapped=nullptr;D3D12_RANGE range{0,static_cast<SIZE_T>(r.size)};
    Hr(ID3D12Resource_Map(r.buffer,0,&range,reinterpret_cast<void**>(&mapped)),"raw readback map");
    std::vector<unsigned char> result(static_cast<size_t>(r.row_bytes)*r.rows);
    for(UINT y=0;y<r.rows;++y)std::memcpy(result.data()+static_cast<size_t>(y*r.row_bytes),
        mapped+r.footprint.Offset+static_cast<size_t>(y)*r.footprint.Footprint.RowPitch,static_cast<size_t>(r.row_bytes));
    D3D12_RANGE none{};ID3D12Resource_Unmap(r.buffer,0,&none);ReleaseCom(r.buffer);return result;
}
struct DepthStencilInput{ID3D12Resource* resource=nullptr;ID3D12DescriptorHeap* heap=nullptr;};
DepthStencilInput DepthStencil(Harness& h,unsigned width,unsigned height,const D3D12_RECT& active){
    DepthStencilInput out;D3D12_HEAP_PROPERTIES heap{};heap.Type=D3D12_HEAP_TYPE_DEFAULT;heap.CreationNodeMask=heap.VisibleNodeMask=1;
    D3D12_RESOURCE_DESC desc{};desc.Dimension=D3D12_RESOURCE_DIMENSION_TEXTURE2D;desc.Width=width;desc.Height=height;
    desc.DepthOrArraySize=desc.MipLevels=desc.SampleDesc.Count=1;desc.Format=DXGI_FORMAT_R32G8X24_TYPELESS;
    desc.Flags=D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL;D3D12_CLEAR_VALUE clear{};clear.Format=DXGI_FORMAT_D32_FLOAT_S8X24_UINT;
    clear.DepthStencil={0.125f,0};Hr(ID3D12Device_CreateCommittedResource(h.device,&heap,D3D12_HEAP_FLAG_NONE,&desc,
        D3D12_RESOURCE_STATE_DEPTH_WRITE,&clear,IID_ID3D12Resource,reinterpret_cast<void**>(&out.resource)),"padded depth-stencil input");
    D3D12_DESCRIPTOR_HEAP_DESC hd{};hd.Type=D3D12_DESCRIPTOR_HEAP_TYPE_DSV;hd.NumDescriptors=1;
    Hr(ID3D12Device_CreateDescriptorHeap(h.device,&hd,IID_ID3D12DescriptorHeap,reinterpret_cast<void**>(&out.heap)),"depth descriptor heap");
    D3D12_DEPTH_STENCIL_VIEW_DESC view{};view.Format=DXGI_FORMAT_D32_FLOAT_S8X24_UINT;view.ViewDimension=D3D12_DSV_DIMENSION_TEXTURE2D;
    const auto handle=ID3D12DescriptorHeap_GetCPUDescriptorHandleForHeapStart(out.heap);ID3D12Device_CreateDepthStencilView(h.device,out.resource,&view,handle);
    ID3D12GraphicsCommandList_ClearDepthStencilView(h.list,handle,D3D12_CLEAR_FLAG_DEPTH,0.125f,0,0,nullptr);
    ID3D12GraphicsCommandList_ClearDepthStencilView(h.list,handle,D3D12_CLEAR_FLAG_DEPTH,0.625f,0,1,&active);
    auto state=D3D12_RESOURCE_STATE_DEPTH_WRITE;Transition(h.list,out.resource,state,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);return out;
}
std::uint16_t HalfPattern(unsigned x,unsigned y,unsigned component){
    static constexpr std::uint16_t values[]={0x3800,0xb800,0x3400,0xb400,0x3c00,0xbc00};
    return values[(x+3*y+component)%std::size(values)];
}
ID3D12Resource* HalfMotion(Harness& h,unsigned width,unsigned height,ID3D12Resource*& upload){
    D3D12_HEAP_PROPERTIES heap{};heap.Type=D3D12_HEAP_TYPE_DEFAULT;heap.CreationNodeMask=heap.VisibleNodeMask=1;
    D3D12_RESOURCE_DESC desc{};desc.Dimension=D3D12_RESOURCE_DIMENSION_TEXTURE2D;desc.Width=width;desc.Height=height;
    desc.DepthOrArraySize=desc.MipLevels=desc.SampleDesc.Count=1;desc.Format=DXGI_FORMAT_R16G16_FLOAT;
    ID3D12Resource* result=nullptr;Hr(ID3D12Device_CreateCommittedResource(h.device,&heap,D3D12_HEAP_FLAG_NONE,&desc,
        D3D12_RESOURCE_STATE_COPY_DEST,nullptr,IID_ID3D12Resource,reinterpret_cast<void**>(&result)),"signed half motion input");
    D3D12_PLACED_SUBRESOURCE_FOOTPRINT fp{};UINT64 size=0;ID3D12Device_GetCopyableFootprints(h.device,&desc,0,1,0,&fp,nullptr,nullptr,&size);
    upload=Buffer(h.device,size,D3D12_HEAP_TYPE_UPLOAD);unsigned char* mapped=nullptr;D3D12_RANGE none{};
    Hr(ID3D12Resource_Map(upload,0,&none,reinterpret_cast<void**>(&mapped)),"half motion upload map");std::memset(mapped,0,size);
    for(unsigned y=0;y<height;++y)for(unsigned x=0;x<width;++x)for(unsigned c=0;c<2;++c){
        const auto value=HalfPattern(x,y,c);std::memcpy(mapped+fp.Offset+y*fp.Footprint.RowPitch+(x*2+c)*2,&value,2);}
    ID3D12Resource_Unmap(upload,0,nullptr);D3D12_TEXTURE_COPY_LOCATION from{},to{};
    from.pResource=upload;from.Type=D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;from.PlacedFootprint=fp;
    to.pResource=result;to.Type=D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;ID3D12GraphicsCommandList_CopyTextureRegion(h.list,&to,0,0,0,&from,nullptr);
    auto state=D3D12_RESOURCE_STATE_COPY_DEST;Transition(h.list,result,state,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);return result;
}
void ObserveReadable(ID3D12GraphicsCommandList* list,ID3D12Resource* resource){
    auto state=D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
    Transition(list,resource,state,D3D12_RESOURCE_STATE_COPY_SOURCE);Transition(list,resource,state,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
}
void ResetTransportCase(){
    using namespace transport;present_guides=nullptr;present_lease={};present_ticket={};present_recorded=false;
    for(auto& copy:guide_copies)ClearGuideCopy(copy);for(auto& stream:receipt_streams)stream={};for(auto& device:receipt_devices)device={};
    next_receipt_opportunity=1;guides_awaiting_submission=false;guides_awaiting_retirement=false;guide_receipt_diagnostics={};
}
struct OwnedPixels{std::vector<unsigned char> depth,motion;UINT64 depth_row=0,motion_row=0;};
OwnedPixels ConsumeOwned(Harness& h,transport::GuideCopy& copy,nr_source_frame::Source source,unsigned output_width,unsigned output_height,unsigned config){
    using namespace transport;ID3D12CommandQueue* queue=nullptr;D3D12_COMMAND_QUEUE_DESC desc{};
    Hr(ID3D12Device_CreateCommandQueue(h.device,&desc,IID_ID3D12CommandQueue,reinterpret_cast<void**>(&queue)),"guide consumer queue");
    const auto selected=AcquirePresentGuides(RecordingOf(h.list).device,output_width,output_height,false,false,false,QueueOf(queue),config);
    Check(selected&&present_lease.cross_queue_wait&&present_lease.producer_fence==copy.producer_fence&&
        present_lease.producer_value==copy.producer_value,"exact producer receipt selected for WARP consumer");
    Label claim{source,Role::Application};present_ticket=claims.Begin(claim,Point::Present);Check(bool(present_ticket),"guide pixel claim begins");
    Consumer consumer(h.device,queue);Check(BeginPresentReceiptWork(queue),"consumer waits on exact producer fence");
    auto depth=ReadRaw(consumer.device,consumer.list,copy.owned[0],static_cast<D3D12_RESOURCE_STATES>(copy.owned_state[0]));
    auto motion=ReadRaw(consumer.device,consumer.list,copy.owned[1],static_cast<D3D12_RESOURCE_STATES>(copy.owned_state[1]));
    OwnedPixels pixels;pixels.depth_row=depth.row_bytes;pixels.motion_row=motion.row_bytes;
    consumer.Submit();ReleasePresentGuides(consumer.fence,consumer.value,true);consumer.Wait();
    pixels.depth=Compact(depth);pixels.motion=Compact(motion);
    Check(claims.Complete(present_ticket,true,true),"guide pixel claim completes at consumer fence");present_ticket={};present_recorded=false;
    Check(GuideReusable(copy),"producer and consumer exact fences permit guide reuse");ReleaseCom(queue);return pixels;
}
void CompareCrop(const std::vector<unsigned char>& source,UINT64 source_row,unsigned x,unsigned y,
    const std::vector<unsigned char>& output,UINT64 output_row,unsigned width,unsigned height,unsigned bytes_per_pixel,const char* why){
    for(unsigned row=0;row<height;++row)Check(std::memcmp(source.data()+(row+y)*source_row+x*bytes_per_pixel,
        output.data()+row*output_row,width*bytes_per_pixel)==0,why);
}
void RunPaddedDepthCopyCase(){
    ResetTransportCase();Harness h;constexpr unsigned width=2228,physical_height=1256,active_height=1253;
    const D3D12_RECT active{0,0,static_cast<LONG>(width),static_cast<LONG>(active_height)};
    auto depth=DepthStencil(h,width,physical_height,active);ID3D12Resource* motion_upload=nullptr;
    auto* motion=HalfMotion(h,width,active_height,motion_upload);h.Submit(false);h.Wait();ReleaseCom(depth.heap);ReleaseCom(motion_upload);
    h.Reset();auto depth_before_read=ReadRaw(h.device,h.list,depth.resource,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
    auto motion_before_read=ReadRaw(h.device,h.list,motion,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);h.Submit(false);h.Wait();
    auto depth_before=Compact(depth_before_read),motion_before=Compact(motion_before_read);
    h.Reset();ObserveReadable(h.list,depth.resource);ObserveReadable(h.list,motion);
    NrGuideBinding guides{};guides.depth=depth.resource;guides.motion=motion;auto& s=guides.signature;
    s.depth_width=s.motion_source_width=width;s.depth_height=s.motion_source_height=active_height;
    s.depth_physical_width=width;s.depth_physical_height=physical_height;s.motion_physical_width=width;s.motion_physical_height=active_height;
    s.motion_bound_width=width;s.motion_bound_height=active_height;s.depth_format=DXGI_FORMAT_R32G8X24_TYPELESS;s.motion_format=DXGI_FORMAT_R16G16_FLOAT;
    s.motion_scale_x=2228;s.motion_scale_y=-1253;guides.valid_motion_scale_x=guides.valid_motion_scale_y=true;guides.jitter.known=true;
    using namespace transport;const Source source{901,1,1};const auto device=RecordingOf(h.list).device;BeginNativeReceiptOpportunity(source,device);
    Check(CaptureGuides(h.list,source,guides,width,active_height,17,true),"NTE padded depth guide capture records");auto& copy=guide_copies[0];
    Check(!copy.shader_snapshot&&copy.source_signature.depth_physical_width==width&&
        copy.source_signature.depth_physical_height==physical_height&&copy.source_signature.depth_height==active_height&&
        copy.guides.signature.depth_physical_width==width&&
        copy.guides.signature.depth_physical_height==physical_height&&copy.guides.signature.depth_height==active_height&&
        ID3D12Resource_GetDesc(copy.owned[0]).Height==physical_height,"full depth-stencil copy preserves padded physical layout and active height");
    CompleteNativeReceipt(source,true);h.Submit(true);h.Wait();Check(FenceDone(copy.producer_fence,copy.producer_value),"padded guide producer fence completes exactly");
    h.Reset();auto depth_after_read=ReadRaw(h.device,h.list,depth.resource,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
    auto motion_after_read=ReadRaw(h.device,h.list,motion,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);h.Submit(false);h.Wait();
    const auto depth_after=Compact(depth_after_read),motion_after=Compact(motion_after_read);
    Check(depth_before==depth_after&&motion_before==motion_after,"full-subresource capture leaves padded depth and signed half motion sources unchanged");
    const auto owned=ConsumeOwned(h,copy,source,width,active_height,17);
    Check(depth_before==owned.depth,"full depth-stencil subresource bytes reach the owned padded guide");
    CompareCrop(motion_before,width*4,0,0,owned.motion,owned.motion_row,width,active_height,4,"signed half motion pixels reach owned guide exactly");
    bool positive=false,negative=false;for(size_t i=0;i+1<owned.motion.size();i+=2){std::uint16_t value=0;std::memcpy(&value,owned.motion.data()+i,2);
        positive|=(value&0x8000)==0;negative|=(value&0x8000)!=0;}Check(positive&&negative,"owned motion retains positive and negative half values");
    CollectGuideInputs();ResetTransportCase();ReleaseCom(depth.resource);ReleaseCom(motion);
}
void RunNativeShaderSnapshotCase(){
    ResetTransportCase();Harness h;const D3D12_RECT active{3,4,14,11};auto depth=DepthStencil(h,19,13,active);
    ID3D12Resource* motion_upload=nullptr;auto* motion=HalfMotion(h,17,12,motion_upload);
    auto* predicate_upload=Buffer(h.device,8,D3D12_HEAP_TYPE_UPLOAD);auto* predicate=Buffer(h.device,8,D3D12_HEAP_TYPE_DEFAULT);
    void* mapped=nullptr;D3D12_RANGE none{};Hr(ID3D12Resource_Map(predicate_upload,0,&none,&mapped),"predicate upload map");
    *static_cast<UINT64*>(mapped)=1;ID3D12Resource_Unmap(predicate_upload,0,nullptr);ID3D12GraphicsCommandList_CopyBufferRegion(h.list,predicate,0,predicate_upload,0,8);
    auto predicate_state=D3D12_RESOURCE_STATE_COPY_DEST;Transition(h.list,predicate,predicate_state,D3D12_RESOURCE_STATE_PREDICATION);
    h.Submit(false);h.Wait();ReleaseCom(depth.heap);ReleaseCom(motion_upload);ReleaseCom(predicate_upload);
    h.Reset();auto depth_before_read=ReadRaw(h.device,h.list,depth.resource,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
    auto motion_before_read=ReadRaw(h.device,h.list,motion,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);h.Submit(false);h.Wait();
    auto depth_before=Compact(depth_before_read),motion_before=Compact(motion_before_read);h.Reset();
    ID3D12GraphicsCommandList_SetPredication(h.list,predicate,0,D3D12_PREDICATION_OP_EQUAL_ZERO);
    NrGuideBinding guides{};guides.depth=depth.resource;guides.motion=motion;auto& s=guides.signature;
    s.depth_x=3;s.depth_y=4;s.depth_width=11;s.depth_height=7;s.depth_physical_width=19;s.depth_physical_height=13;
    s.motion_x=2;s.motion_y=3;s.motion_source_width=11;s.motion_source_height=7;s.motion_physical_width=17;s.motion_physical_height=12;
    s.motion_bound_width=11;s.motion_bound_height=7;s.depth_format=DXGI_FORMAT_R32G8X24_TYPELESS;s.motion_format=DXGI_FORMAT_R16G16_FLOAT;
    s.motion_scale_x=2228;s.motion_scale_y=-1253;guides.valid_motion_scale_x=guides.valid_motion_scale_y=true;guides.jitter.known=true;
    using namespace transport;const Source source{902,1,1};const auto device=RecordingOf(h.list).device;BeginNativeReceiptOpportunity(source,device);
    Check(CaptureGuides(h.list,source,guides,11,7,18,true),"unknown native-seam state uses real shader snapshot");auto& copy=guide_copies[0];
    unsigned observed=0;Check(copy.shader_snapshot&&!StateOf(RecordingOf(h.list),ResourceOf(depth.resource),observed)&&
        !StateOf(RecordingOf(h.list),ResourceOf(motion),observed),"shader snapshot does not fabricate input state or input barriers");
    Check(copy.source_signature.depth_x==3&&copy.source_signature.depth_y==4&&copy.source_signature.depth_physical_width==19&&
        copy.source_signature.depth_physical_height==13&&copy.guides.signature.depth_x==0&&copy.guides.signature.depth_y==0&&
        copy.guides.signature.depth_physical_width==11&&copy.guides.signature.depth_physical_height==7&&
        copy.guides.signature.motion_format==DXGI_FORMAT_R16G16_FLOAT&&copy.guides.signature.motion_scale_x==2228&&
        copy.guides.signature.motion_scale_y==-1253&&copy.guides.jitter.known,
        "nonzero source origin, signed scale and physical layout remain distinct from cropped owned guides");
    CompleteNativeReceipt(source,true);h.Submit(true);h.Wait();Check(FenceDone(copy.producer_fence,copy.producer_value),"shader guide producer fence completes exactly");
    h.Reset();auto depth_after_read=ReadRaw(h.device,h.list,depth.resource,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
    auto motion_after_read=ReadRaw(h.device,h.list,motion,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);h.Submit(false);h.Wait();
    const auto depth_after=Compact(depth_after_read),motion_after=Compact(motion_after_read);
    Check(depth_before==depth_after&&motion_before==motion_after,"shader snapshot leaves nonzero-origin depth and motion sources unchanged");
    const auto owned=ConsumeOwned(h,copy,source,11,7,18);
    for(unsigned y=0;y<7;++y)for(unsigned x=0;x<11;++x){float value=0;std::memcpy(&value,owned.depth.data()+y*owned.depth_row+x*4,4);
        Check(value==0.625f,"predicate-cleared shader copies active depth pixels");}
    CompareCrop(motion_before,17*4,2,3,owned.motion,owned.motion_row,11,7,4,"shader copies signed half motion from nonzero origin");
    CollectGuideInputs();ResetTransportCase();ReleaseCom(depth.resource);ReleaseCom(motion);ReleaseCom(predicate);
}
void RunContradictoryNativeStateCase(){
    ResetTransportCase();Harness h;ID3D12Resource *du=nullptr,*mu=nullptr;
    auto* depth=Input(h,DXGI_FORMAT_R32_FLOAT,1,du,D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS);
    auto* motion=HalfMotion(h,8,8,mu);auto state=D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
    Transition(h.list,depth,state,D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
    h.Submit(false);h.Wait();h.Reset();
    Transition(h.list,depth,state,D3D12_RESOURCE_STATE_COPY_SOURCE);
    Transition(h.list,depth,state,D3D12_RESOURCE_STATE_UNORDERED_ACCESS); // depth known contradictory; motion unknown in this recording
    NrGuideBinding guides{};guides.depth=depth;guides.motion=motion;guides.signature.depth_width=guides.signature.motion_source_width=8;
    guides.signature.depth_height=guides.signature.motion_source_height=8;guides.valid_motion_scale_x=guides.valid_motion_scale_y=true;
    using namespace transport;const Source source{903,1,1};BeginNativeReceiptOpportunity(source,RecordingOf(h.list).device);
    Check(!CaptureGuides(h.list,source,guides,8,8,19,true),"actual contradictory tracked state refuses native-seam shader fallback");
    Check(std::strcmp(guide_receipt_diagnostics.last.stage,"native-guide-read-state-conflict")==0,
        "contradictory native state has an exact refusal diagnostic");
    h.Submit(false);h.Wait();ResetTransportCase();ReleaseCom(depth);ReleaseCom(motion);ReleaseCom(du);ReleaseCom(mu);
}
int main(){try{InitializeCriticalSection(&g_chain_cs);
    RunPaddedDepthCopyCase();RunNativeShaderSnapshotCase();RunContradictoryNativeStateCase();
    Harness h;ID3D12Resource *depth_upload=nullptr,*motion_upload=nullptr;
    auto* depth=Input(h,DXGI_FORMAT_R32_FLOAT,1,depth_upload);auto* motion=Input(h,DXGI_FORMAT_R32G32_FLOAT,2,motion_upload);
    NrGuideBinding g{};g.depth=depth;g.motion=motion;g.signature.depth_x=1;g.signature.depth_y=2;
    g.signature.motion_x=2;g.signature.motion_y=1;g.signature.depth_width=g.signature.motion_source_width=4;
    g.signature.depth_height=g.signature.motion_source_height=3;
    using namespace transport;Source first{1,1,1};const auto device_id=RecordingOf(h.list).device;
    BeginNativeReceiptOpportunity(first,device_id);
    reshade::api::device owner;reshade::api::resource_view view{4567};reshade::api::resource_view_desc view_desc;
    const auto objects_before=source_objects.load();nr_processing_runtime::work_enabled=false;
    OnSourceInitView(&owner,{reinterpret_cast<Id>(depth)},reshade::api::resource_usage::render_target,view_desc,view);
    Check(source_objects.load()==objects_before,"off-created RTV caches scalar receipt without querying or retaining COM identity");
    nr_processing_runtime::work_enabled=true;
    auto* first_view=FindSourceRtv(view.handle,ResourceOf(depth).device);
    Check(first_view&&first_view->resource.address==reinterpret_cast<Id>(depth)&&first_view->resource.lifetime,"on-use resolves the off-created RTV from the real resource");
    Check(first_view&&first_view->whole,"default RTV resolves to whole only after actual single-surface verification");
    nr_processing_runtime::work_enabled=false;OnSourceDestroyView(&owner,view);
    OnSourceInitView(&owner,{reinterpret_cast<Id>(motion)},reshade::api::resource_usage::render_target,view_desc,view);
    nr_processing_runtime::work_enabled=true;
    auto* resized_view=FindSourceRtv(view.handle,ResourceOf(motion).device);
    Check(resized_view&&resized_view->resource.address==reinterpret_cast<Id>(motion),"off resize view replacement resolves new resource on enabled use");
    OnSourceDestroyView(&owner,view);Check(!FindSourceRtv(view.handle,ResourceOf(motion).device),"destroyed view cannot lend old resource identity");
    auto* full_view=ViewShape(h,1,1,1);CheckViewClear(h,full_view,{},true);
    reshade::api::resource_view_desc explicit_view;explicit_view.type=reshade::api::resource_view_type::texture_2d;
    CheckViewClear(h,full_view,explicit_view,true);
    explicit_view.texture.first_level=1;CheckViewClear(h,full_view,explicit_view,false);
    explicit_view.texture.first_level=0;explicit_view.texture.first_layer=1;CheckViewClear(h,full_view,explicit_view,false);
    explicit_view.texture.first_layer=0;explicit_view.type=reshade::api::resource_view_type::texture_2d_array;
    CheckViewClear(h,full_view,explicit_view,false);
    for(const auto shape:{std::array<unsigned,3>{2,1,1},{1,2,1},{1,1,2}}){
        auto* incomplete=ViewShape(h,shape[0],shape[1],shape[2]);CheckViewClear(h,incomplete,{},false);ReleaseCom(incomplete);}
    ReleaseCom(full_view);
    nr_processing_runtime::session.Select(nr_processing::Start::Present,1);NgxParams parameters;FeatureRecord feature;
    CaptureNgxGuides(h.list,&parameters,feature,first);Check(resource_parameter_reads==1,"API not initialized and not failed still allows initial guide probe");
    g_nr_failed_create_process_latched=true;CaptureNgxGuides(h.list,&parameters,feature,first);g_nr_failed_create_process_latched=false;
    g_lifecycle_tracking_uncertain=true;CaptureNgxGuides(h.list,&parameters,feature,first);g_lifecycle_tracking_uncertain=false;
    other_nr_owner=true;CaptureNgxGuides(h.list,&parameters,feature,first);other_nr_owner=false;
    g_codec.failed=true;CaptureNgxGuides(h.list,&parameters,feature,first);g_codec.failed=false;
    g_nr_api.failed=true;CaptureNgxGuides(h.list,&parameters,feature,first);g_nr_api.failed=false;
    Check(resource_parameter_reads==1,"hard failure lifecycle owner codec and NR API refusal performs no guide-resource probe");
    nr_processing_runtime::session.Reject(nr_processing::Start::Present,1,"fixture transient",true);
    CaptureNgxGuides(h.list,&parameters,feature,{1,1,2});Check(resource_parameter_reads==1,"Present retry delay prevents guide-resource probe");
    CaptureNgxGuides(h.list,&parameters,feature,{1,1,5});Check(resource_parameter_reads==2,"actual later eligible source permits retry probe");
    unsigned observed=0;Check(StateOf(RecordingOf(h.list),ResourceOf(depth),observed)&&observed==D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,"actual legacy transition establishes source read state");
    OnEnhancedBarrier(h.list);
    Check(!StateOf(RecordingOf(h.list),ResourceOf(depth),observed),"enhanced boundary invalidates older legacy state");
    Check(!CaptureGuides(h.list,first,g,8,8,0),"legacy-to-enhanced unknown entry does not allocate or record");
    for(auto* resource:{depth,motion}){auto state=D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
        Transition(h.list,resource,state,D3D12_RESOURCE_STATE_COPY_SOURCE);Transition(h.list,resource,state,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);}
    g.signature.linear_depth=true;Check(!CaptureGuides(h.list,first,g,8,8,0),"RR linear raw depth is not a normalized guide");g.signature.linear_depth=false;
    nr_processing_runtime::work_enabled=false;Check(!CaptureGuides(h.list,first,g,8,8,0),"F6/zero strength performs no guide work");nr_processing_runtime::work_enabled=true;
    Check(CaptureGuides(h.list,first,g,8,8,0),"record actual native copy");auto& copy=guide_copies[0];
    auto* owned_depth=copy.owned[0];auto* owned_motion=copy.owned[1];auto* producer_fence=copy.producer_fence;
    Check(owned_depth!=depth&&owned_motion!=motion&&copy.recorded&&!copy.submitted,"guides are owned and not falsely submitted");
    Check(copy.source_signature.depth_x==1&&copy.source_signature.depth_y==2&&copy.guides.signature.depth_x==0&&
        copy.output_width==8&&copy.output_height==8,"receipt preserves source subrect separately from owned copy coordinates");
    Check(CaptureGuides(h.list,first,g,8,8,0)&&!guide_copies[1].recorded,"duplicate source cannot duplicate copies");
    auto selected=AcquirePresentGuides(device_id,8,8,false,false,false,QueueOf(h.queue),0);
    Check(!selected&&selected.decision==nr_late_present::Decision::NativeResultPending&&!present_guides,"pre-success copy cannot become a receipt");
    CompleteNativeReceipt(first,true);
    selected=AcquirePresentGuides(device_id,8,8,false,false,false,QueueOf(h.queue),0);
    Check(!selected&&selected.decision==nr_late_present::Decision::Unsubmitted&&!present_guides,"successful but unsubmitted receipt rejected");
    ID3D12Fence* producer_gate=nullptr;Hr(ID3D12Device_CreateFence(h.device,0,D3D12_FENCE_FLAG_NONE,
        IID_ID3D12Fence,reinterpret_cast<void**>(&producer_gate)),"producer blocker fence");
    Hr(ID3D12CommandQueue_Wait(h.queue,producer_gate,1),"enqueue producer blocker");
    h.Submit(true);Check(copy.submitted&&!FenceDone(copy.producer_fence,copy.producer_value),
        "actual Execute publishes an intentionally incomplete producer fence");
    ID3D12CommandQueue* another_queue=nullptr;D3D12_COMMAND_QUEUE_DESC queue_desc{};
    Hr(ID3D12Device_CreateCommandQueue(h.device,&queue_desc,IID_ID3D12CommandQueue,reinterpret_cast<void**>(&another_queue)),"other real queue");
    Check(QueueOf(another_queue)!=QueueOf(h.queue),"queue generation is an object cookie rather than a reused address proof");
    selected=AcquirePresentGuides(device_id,8,8,false,false,false,QueueOf(another_queue),0);
    Check(selected&&present_guides==&copy&&present_lease.cross_queue_wait,"same-device queue mismatch acquires exact receipt for GPU wait");
    Label claim{first,Role::Application};present_ticket=claims.Begin(claim,Point::Present);Check(bool(present_ticket),"receipt source claim begins");
    {Consumer consumer(h.device,another_queue);
        Check(BeginPresentReceiptWork(another_queue)&&present_recorded&&copy.consumed,"private work consumes receipt and records cross-queue GPU wait");
        auto d=Read(consumer.device,consumer.list,owned_depth);auto m=Read(consumer.device,consumer.list,owned_motion);consumer.Submit();
        Check(!FenceDone(consumer.fence,consumer.value),"consumer remains blocked behind exact producer fence");
        Hr(ID3D12Fence_Signal(producer_gate,1),"release producer blocker");
        ReleasePresentGuides(consumer.fence,consumer.value,true);consumer.Wait();Verify(d,1,2,1);Verify(m,2,1,2);
        Check(claims.Complete(present_ticket,true,true),"consumer completion closes exact source claim");present_ticket={};present_recorded=false;}
    selected=AcquirePresentGuides(device_id,8,8,false,false,false,QueueOf(h.queue),0);
    Check(!selected&&selected.decision==nr_late_present::Decision::AlreadyConsumed,"actual source cannot run twice");
    h.Wait();ReleaseCom(producer_gate);ReleaseCom(another_queue);
    CollectGuideInputs();Check(!copy.inputs[0]&&!copy.inputs[1],"original application references retire at producer fence");
    Check(GuideReusable(copy),"exact consumer fence permits pool reuse");h.Reset();
    for(auto* resource:{depth,motion}){auto state=D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
        Transition(h.list,resource,state,D3D12_RESOURCE_STATE_COPY_SOURCE);Transition(h.list,resource,state,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);}
    const Source second{1,1,2};BeginNativeReceiptOpportunity(second,device_id);
    Check(CaptureGuides(h.list,second,g,8,8,0),"next source records reused texture");CompleteNativeReceipt(second,true);
    Check(copy.owned[0]==owned_depth&&copy.owned[1]==owned_motion&&copy.producer_fence==producer_fence,"same format and extent reuse allocations and producer fence");
    h.Submit(true);h.Wait();Check(copy.producer_value==2,"reused producer fence has monotonic real value");
    selected=AcquirePresentGuides(device_id,8,8,false,false,false,QueueOf(h.queue),0);
    Check(selected&&!present_lease.cross_queue_wait,"same producer/Present queue needs no explicit wait");
    claim={second,Role::Application};present_ticket=claims.Begin(claim,Point::Present);Check(bool(present_ticket)&&BeginPresentReceiptWork(h.queue),"same-queue private work consumes ordered receipt");
    h.Reset();auto d2=Read(h.device,h.list,owned_depth);auto m2=Read(h.device,h.list,owned_motion);h.Submit(false);
    ReleasePresentGuides(h.fence,h.value,true);h.Wait();Verify(d2,1,2,1);Verify(m2,2,1,2);
    Check(claims.Complete(present_ticket,true,true),"same-queue consumer completion closes claim");present_ticket={};present_recorded=false;
    h.Reset();for(auto* resource:{depth,motion}){auto state=D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
        Transition(h.list,resource,state,D3D12_RESOURCE_STATE_COPY_SOURCE);Transition(h.list,resource,state,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);}
    const Source failed{1,1,3};BeginNativeReceiptOpportunity(failed,device_id);
    Check(CaptureGuides(h.list,failed,g,8,8,0),"failed native attempt still records owned pre-call copy");
    CompleteNativeReceipt(failed,false);h.Submit(true);h.Wait();
    selected=AcquirePresentGuides(device_id,8,8,false,false,false,QueueOf(h.queue),0);
    Check(!selected&&selected.decision==nr_late_present::Decision::NativeFailed&&!present_guides,
        "actual failed native result never becomes an eligible Present receipt");
    CollectGuideInputs();Check(GuideReusable(copy)&&!copy.inputs[0]&&!copy.inputs[1],
        "failed native receipt retires bounded copy inputs and returns slot after exact producer fence");
    CollectGuideInputs();for(auto& item:guide_copies)ClearGuideCopy(item);
    ReleaseCom(depth);ReleaseCom(motion);ReleaseCom(depth_upload);ReleaseCom(motion_upload);
    std::printf("source-transport WARP: %u checks passed; NGX/FG inference not tested\n",checks);return 0;
}catch(const std::exception& e){std::fprintf(stderr,"FAIL: %s\n",e.what());return 1;}}
