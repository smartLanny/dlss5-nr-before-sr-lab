unsigned checks=0;
void Check(bool value,const char* why){++checks;if(!value)throw std::runtime_error(why);}
void Hr(HRESULT value,const char* why){Check(SUCCEEDED(value),why);}
template<class T>void ReleaseCom(T*& object){if(object){IUnknown_Release(reinterpret_cast<IUnknown*>(object));object=nullptr;}}
namespace transport {void OnBarrier(ID3D12GraphicsCommandList*,unsigned,const D3D12_RESOURCE_BARRIER*);}
void Transition(ID3D12GraphicsCommandList* list,ID3D12Resource* resource,D3D12_RESOURCE_STATES& state,D3D12_RESOURCE_STATES next){
    if(state==next)return;D3D12_RESOURCE_BARRIER barrier{};barrier.Type=D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
    barrier.Transition={resource,D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES,state,next};
    ID3D12GraphicsCommandList_ResourceBarrier(list,1,&barrier);state=next;transport::OnBarrier(list,1,&barrier);
}
bool IsSameRrDepthDevice(ID3D12Device* left,ID3D12Device* right){return left&&left==right;}
