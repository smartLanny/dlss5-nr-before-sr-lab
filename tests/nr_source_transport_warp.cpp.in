// The surrounding Core recording/state observers are controlled test inputs;
// all allocations, command copies, transitions, queues and fences are real WARP.
SRWLOCK lock=SRWLOCK_INIT;
struct Lock{Lock(){AcquireSRWLockExclusive(&lock);}~Lock(){ReleaseSRWLockExclusive(&lock);}};
Id recording_reset=1;nr_source_frame::Lineage lineage;std::atomic<bool> source_receipts_pending{false};
std::atomic<Id> source_objects{1};
// @ACTUAL_OBJECT_COOKIES@
Recording RecordingOf(ID3D12GraphicsCommandList* list){return {reinterpret_cast<Id>(list),ObjectId(reinterpret_cast<ID3D12Object*>(list)),recording_reset,DeviceOf(reinterpret_cast<ID3D12DeviceChild*>(list))};}
Resource ResourceOf(ID3D12Resource* resource){return resource?Resource{reinterpret_cast<Id>(resource),ObjectId(reinterpret_cast<ID3D12Object*>(resource)),DeviceOf(reinterpret_cast<ID3D12DeviceChild*>(resource)),0}:Resource{};}
